  clear
  show_logo
  if [[ "$L" == "ar" ]]; then
cat <<EOF
======= $ICON_OTHER خيارات تنزيل أخرى ==============
1) تحميل قائمة تشغيل كاملة
2) تحميل قناة كاملة
3) تنزيل من ملف نصي (قائمة روابط)
4) تحويل عدة روابط دفعة واحدة
5) تنزيل فيديوهات خاصة
6) عرض سجل التنزيلات
0) عودة
EOF
  else
cat <<EOF
======= $ICON_OTHER Other Download Options =========
1) Download full playlist
2) Download entire channel
3) Download from text file (URLs)
4) Batch convert URLs
5) Download private videos
6) Show download history
0) Back
EOF
  fi
  read -p "[0-6]: " subopt
  [[ "$subopt" == 0 ]] && main_menu || other_download_menu
}

settings_menu() {
  clear
  show_logo
  if [[ "$L" == "ar" ]]; then
cat <<EOF
============ $ICON_SETTINGS settings/إعدادات =============
1) اختيار اللغة (AR/EN)
2) تغيير مجلد الحفظ الافتراضي (حالي: $SAVE_PATH)
3) التحكم في الإشعارات
4) إعدادات متقدمة (yt-dlp / ffmpeg)
5) تحقق/تحديث البرنامج
6) $ICON_INSTALL تثبيت اختصار سطح المكتب
7) استعادة الافتراضي
0) عودة
EOF
  else
cat <<EOF
============ $ICON_SETTINGS settings/إعدادات =============
1) Change language (AR/EN)
2) Change default save folder (current: $SAVE_PATH)
3) Notification settings
4) Advanced settings (yt-dlp / ffmpeg)
5) Check/Update program
6) $ICON_INSTALL Install desktop shortcut
7) Restore defaults
0) Back
EOF
  fi
  read -p "[0-7]: " setopt
  case $setopt in
    1) choose_language_menu; settings_menu;;
    2) 
      if [[ "$L" == "ar" ]]; then
        read -p "أدخل مسار المجلد الجديد: " SAVE_PATH
      else
        read -p "Enter new save folder path: " SAVE_PATH
      fi
      settings_menu;;
    3) ;; # خاصية إعداد الإشعارات
    4) ;; # إعدادات متقدمة
    5) update_yt_dlp; self_update;;
    6) install_desktop_shortcut; press_enter; settings_menu;;
    7) SAVE_PATH="$DEFAULT_SAVE_PATH"; LANGUAGE="$SYS_LANG"; set_lang; settings_menu;;
    0) main_menu;;
    *) settings_menu;;
  esac
}

install_desktop_shortcut() {
  local DESKTOP_DIR="$HOME/.local/share/applications"
  local ICON_DIR="$HOME/.local/share/icons"
  local ICON_NAME="gmd-icon.png"
  local ICON_PATH="$ICON_DIR/$ICON_NAME"

  mkdir -p "$DESKTOP_DIR" "$ICON_DIR"

  [ -z "$CHECKED_LANG_ONCE" ] && CHECKED_LANG_ONCE="true"  # تمنع تكرار الإشعار في بداية البرنامج

  echo "$ICON_INSTALL تثبيت اختصار سطح المكتب..."

  echo "$ICON_DOWNLOAD تنزيل أيقونة البرنامج..."
  curl -s -L "https://raw.githubusercontent.com/SalehGNUTUX/GMD/main/GMD%20APPIAMGE%20BIULD/gmd-icon.png" -o "$ICON_PATH" 2>/dev/null || {
    echo "$ICON_INFO استخدام أيقونة افتراضية..."
    ICON_PATH="system-search"
  }

  local DESKTOP_FILE="$DESKTOP_DIR/gmd.desktop"
  cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Name=GMD - GNU Media Downloader
Comment=Download and convert media
Exec=$SELF_PATH
Icon=$ICON_PATH
Terminal=true
Type=Application
Categories=Utility;Network;AudioVideo;Audio;Video;
EOF
  if command -v update-desktop-database &>/dev/null; then
    update-desktop-database "$DESKTOP_DIR"
  fi

  if [[ "$L" == "ar" ]]; then
    echo "$ICON_SUCCESS تم إنشاء اختصار سطح المكتب في: $DESKTOP_FILE"
    echo "$ICON_INFO يمكنك الآن العثور على التطبيق في قوائم: أدوات مساعدة، إنترنت، وسائط"
  else
    echo "$ICON_SUCCESS Desktop shortcut created at: $DESKTOP_FILE"
    echo "$ICON_INFO You can now find the app in Utility, Network, AudioVideo menu"
  fi
}

# ----------------------------
# عند أول تثبيت: عرض خيار تثبيت الاختصار
# ----------------------------
show_first_install_shortcut_prompt() {
  if [ ! -e "$HOME/.local/share/applications/gmd.desktop" ] && [ -z "$CHECKED_LANG_ONCE" ]; then
    CHECKED_LANG_ONCE="true"
    if [[ "$L" == "ar" ]]; then
      read -p "$ICON_INSTALL هل ترغب بتثبيت اختصار سطح المكتب الآن؟ [Y/n]: " ans
    else
      read -p "$ICON_INSTALL Do you want to install a desktop shortcut now? [Y/n]: " ans
    fi
    [[ "${ans,,}" =~ ^(y|yes|)$ ]] && install_desktop_shortcut
  fi
}

exit_program() {
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_EXIT مع السلامة!"
  else
    echo "$ICON_EXIT Goodbye!"
  fi
  exit 0
}

# ----------------------------
# البداية: تثبيت yt-dlp والتحديث
# ----------------------------
install_yt_dlp
update_yt_dlp
self_update "$@"
show_first_install_shortcut_prompt

main_menu
