[file content begin]
#!/bin/bash
# GMD - GNU Media Downloader v1.92
# by gnutux

set -euo pipefail

# ----------------------------
# الشعار
# ----------------------------
show_logo() {
echo "
   ____   __  __   ____  
  / ___| |  \/  | |  _ \ 
 | |  _  | |\/| | | | | |
 | |_| | | |  | | | |_| |
  \____| |_|  |_| |____/ 
-------------------------
   GNU MEDIA DOWNLOADER
-------------------------
       » BY GNUTUX «
         » v1.92 «
"
}

show_logo

# ----------------------------
# إعداد اللغة (قابل للتغيير)
# ----------------------------
LANGUAGE="ar"
L="ar"
set_lang() {
  if [[ "$LANGUAGE" == "ar" ]]; then
    L="ar"
  else
    L="en"
  fi
}

set_lang

# ----------------------------
# خيار التبديل بين اللغتين
# ----------------------------
toggle_lang() {
  if [[ "$LANGUAGE" == "ar" ]]; then
    LANGUAGE="en"
    L="en"
  else
    LANGUAGE="ar"
    L="ar"
  fi
  show_logo
  echo ""
  if [[ "$L" == "ar" ]]; then
    echo "✅ تم تغيير اللغة إلى العربية."
  else
    echo "✅ Language switched to English."
  fi
}

# ----------------------------
# وضع التثبيت المباشر وإلغاء التثبيت والتحديث
# ----------------------------
if [[ "${1:-}" == "--install" ]]; then
    echo "⬇️ جاري تثبيت GMD..."
    mkdir -p ~/.local/bin
    # نسخ الملف الحالي بدلاً من التنزيل من الإنترنت
    if [[ -f "$0" ]]; then
        cp "$0" ~/.local/bin/gmd
        chmod +x ~/.local/bin/gmd
        echo "✅ تم تثبيت GMD بنجاح في ~/.local/bin/gmd"
        echo "🎯 يمكنك الآن استخدام الأمر: gmd"
    else
        echo "❌ خطأ: لا يمكن العثور على الملف الحالي"
        exit 1
    fi
    exit 0
fi

if [[ "${1:-}" == "--install-desktop" ]]; then
    echo "⬇️ جاري تثبيت GMD مع اختصار سطح المكتب..."
    mkdir -p ~/.local/bin
    # نسخ الملف الحالي
    if [[ -f "$0" ]]; then
        cp "$0" ~/.local/bin/gmd
        chmod +x ~/.local/bin/gmd
    else
        echo "❌ خطأ: لا يمكن العثور على الملف الحالي"
        exit 1
    fi
    
    DESKTOP_DIR="$HOME/.local/share/applications"
    ICON_DIR="$HOME/.local/share/icons"
    mkdir -p "$DESKTOP_DIR" "$ICON_DIR"
    
    # تحميل الأيقونة (اختياري)
    if command -v curl &>/dev/null; then
        curl -sSL "https://raw.githubusercontent.com/SalehGNUTUX/GMD/main/GMD%20APPIAMGE%20BIULD/gmd-icon.png" -o "$ICON_DIR/gmd-icon.png" 2>/dev/null || true
    fi
    
    # إنشاء ملف .desktop صحيح
    cat > "$DESKTOP_DIR/gmd.desktop" <<EOF
[Desktop Entry]
Name=GMD - GNU Media Downloader
Comment=Download and convert media
Exec=bash -c "~/.local/bin/gmd"
Icon=$ICON_DIR/gmd-icon.png
Terminal=true
Type=Application
Categories=Utility;Network;AudioVideo;Audio;Video;
EOF
    
    chmod +x "$DESKTOP_DIR/gmd.desktop"
    
    if command -v update-desktop-database &>/dev/null; then
        update-desktop-database ~/.local/share/applications
    fi
    
    echo "✅ تم تثبيت GMD بنجاح!"
    echo "📁 تم إضافة اختصار سطح المكتب في قائمة التطبيقات"
    echo "🎯 يمكنك الآن استخدام الأمر: gmd"
    exit 0
fi

if [[ "${1:-}" == "--update" ]]; then
    echo "⬇️ جاري تحديث GMD..."
    # النسخ الآمن
    if [[ -f "$0" ]]; then
        cp "$0" ~/.local/bin/gmd.tmp
        chmod +x ~/.local/bin/gmd.tmp
        mv ~/.local/bin/gmd.tmp ~/.local/bin/gmd
        echo "✅ تم تحديث GMD بنجاح!"
    else
        echo "❌ خطأ: لا يمكن العثور على الملف الحالي"
    fi
    exit 0
fi

if [[ "${1:-}" == "--fix-desktop" ]]; then
    echo "🔧 إصلاح اختصار سطح المكتب..."
    DESKTOP_DIR="$HOME/.local/share/applications"
    ICON_DIR="$HOME/.local/share/icons"
    mkdir -p "$DESKTOP_DIR" "$ICON_DIR"
    
    # إصلاح ملف .desktop
    cat > "$DESKTOP_DIR/gmd.desktop" <<EOF
[Desktop Entry]
Name=GMD - GNU Media Downloader
Comment=Download and convert media
Exec=bash -c "$HOME/.local/bin/gmd"
Icon=system-search
Terminal=true
Type=Application
Categories=Utility;Network;AudioVideo;Audio;Video;
EOF
    
    chmod +x "$DESKTOP_DIR/gmd.desktop"
    
    if command -v update-desktop-database &>/dev/null; then
        update-desktop-database ~/.local/share/applications
    fi
    
    echo "✅ تم إصلاح اختصار سطح المكتب!"
    exit 0
fi

# ----------------------------
# المسارات الأساسية والإعدادات
# ----------------------------
BIN_DIR="$HOME/.local/bin"
mkdir -p "$BIN_DIR"
SELF_PATH="$BIN_DIR/gmd"
YTDLP="$BIN_DIR/yt-dlp"
FILE_MANAGER=$(command -v xdg-open || command -v nemo || command -v nautilus || echo "")
SAVE_PATH=""
UPDATE_MARKER="$HOME/.config/gmd_last_update"
mkdir -p "$(dirname "$UPDATE_MARKER")"

# ----------------------------
# أيقونات وجماليات
# ----------------------------
ICON_DOWNLOAD="⬇️"
ICON_AUDIO="🎵"
ICON_CONVERT="🔄"
ICON_EXTRA="⚡"
ICON_SETTINGS="⚙️"
ICON_INSTALL="📁"
ICON_EXIT="🚪"
ICON_SUCCESS="✅"
ICON_ERROR="❌"
ICON_INFO="ℹ️"
ICON_FOLDER="📂"
ICON_FILE="📄"
ICON_URL="🌐"
ICON_QUALITY="🎞️"
ICON_FORMAT="🎧"
ICON_LANG="🌐"
ICON_BACK="🔙"
ICON_SMART="🧠"
ICON_COMPLETE="📦"

# ----------------------------
# التحقق من التبعيات
# ----------------------------
REQUIRED_CMDS=(ffmpeg curl)
missing=()
for cmd in "${REQUIRED_CMDS[@]}"; do
    if ! command -v "$cmd" &>/dev/null; then
        missing+=("$cmd")
    fi
done

install_deps() {
  if [ "${#missing[@]}" -eq 0 ]; then return; fi
  echo "$ICON_INFO محاولة تثبيت التبعيات المطلوبة تلقائيًا..."
  if command -v apt &>/dev/null; then
    sudo apt update
    for m in "${missing[@]}"; do sudo apt install -y "$m"; done
  elif command -v dnf &>/dev/null; then
    sudo dnf install -y "${missing[@]}"
  elif command -v pacman &>/dev/null; then
    sudo pacman -Sy --noconfirm "${missing[@]}"
  else
    echo "$ICON_ERROR لا يمكن اكتشاف مدير الحزم تلقائيًا. يرجى تثبيت: ${missing[*]}"
    exit 1
  fi
}

if (( ${#missing[@]} > 0 )); then
  echo "$ICON_ERROR التبعيات التالية غير موجودة: ${missing[*]}"
  read -p "هل ترغب بمحاولة تثبيتها تلقائيًا؟ [y/N]: " try_install
  if [[ "${try_install:-}" =~ ^[Yy]$ ]]; then install_deps; else exit 1; fi
fi

# ----------------------------
# تثبيت / تحديث yt-dlp
# ----------------------------
install_yt_dlp() {
  if [ -x "$YTDLP" ]; then
    echo "$ICON_SUCCESS yt-dlp موجود بالفعل."
  else
    echo "$ICON_DOWNLOAD تثبيت yt-dlp من GitHub..."
    if command -v curl &>/dev/null; then
      curl -sSL "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" -o "$YTDLP"
    elif command -v wget &>/dev/null; then
      wget "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" -O "$YTDLP"
    else
      echo "$ICON_ERROR لا يوجد أداة تحميل (curl أو wget)."
      exit 1
    fi
    chmod a+rx "$YTDLP"
    echo "$ICON_SUCCESS تم تثبيت yt-dlp بنجاح."
  fi
}

update_yt_dlp() {
  echo "$ICON_CONVERT تحديث yt-dlp..."
  "$YTDLP" -U || echo "⚠️ فشل التحديث، سيتم استخدام النسخة الحالية."
}

# ----------------------------
# وظائف اختيار المجلد / الملف
# ----------------------------
choose_save_path() {
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_FOLDER أدخل مسار الحفظ (اتركه فارغاً للاستخدام الحالي '$PWD'): "
  else
    echo "$ICON_FOLDER Enter save path (leave empty for current directory '$PWD'): "
  fi
  
  read -p "➤ " SAVE_PATH
  
  if [[ -z "$SAVE_PATH" ]]; then
    SAVE_PATH="$PWD"
  fi
  
  # إنشاء المجلد إذا لم يكن موجوداً
  mkdir -p "$SAVE_PATH"
  
  if [[ ! -d "$SAVE_PATH" ]]; then 
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_ERROR مسار غير صالح."
    else
      echo "$ICON_ERROR Invalid path."
    fi
    return 1
  fi
  
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_INFO سيتم الحفظ في: $SAVE_PATH"
  else
    echo "$ICON_INFO Files will be saved to: $SAVE_PATH"
  fi
  return 0
}

choose_file_path() {
  local FILE=""
  if [[ "$L" == "ar" ]]; then
    read -p "$ICON_FILE أدخل مسار الملف: " FILE
  else
    read -p "$ICON_FILE Enter file path: " FILE
  fi
  
  if [[ ! -f "$FILE" ]]; then 
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_ERROR ملف غير صالح."
    else
      echo "$ICON_ERROR Invalid file."
    fi
    return 1
  fi
  echo "$FILE"
  return 0
}

# ----------------------------
# خيارات الجودة والصيغ المحسنة
# ----------------------------
choose_video_format() {
  if [[ "$L" == "ar" ]]; then
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│        $ICON_FORMAT صيغة الإخراج         │"
    echo "├─────────────────────────────────────┤"
    echo "│  1) mp4 (فيديو - H.264)             │"
    echo "│  2) webm (فيديو - VP9)              │"
    echo "│  3) mp3 (صوت - جودة متوسطة)         │"
    echo "│  4) m4a (صوت - جيدة للأجهزة)        │"
    echo "│  5) ogg (صوت - حجم صغير)            │"
    echo "│  6) opus (صوت - كفاءة عالية)        │"
    echo "│  7) wav (صوت - جودة أصلية)          │"
    echo "│  8) flac (صوت - بدون خسارة)         │"
    echo "└─────────────────────────────────────┘"
  else
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│        $ICON_FORMAT Output Format        │"
    echo "├─────────────────────────────────────┤"
    echo "│  1) mp4 (video - H.264)             │"
    echo "│  2) webm (video - VP9)              │"
    echo "│  3) mp3 (audio - Medium quality)    │"
    echo "│  4) m4a (audio - Good for devices)  │"
    echo "│  5) ogg (audio - Small size)        │"
    echo "│  6) opus (audio - High efficiency)  │"
    echo "│  7) wav (audio - Original quality)  │"
    echo "│  8) flac (audio - Lossless)         │"
    echo "└─────────────────────────────────────┘"
  fi
  read -p "➤ " conv_format
  case $conv_format in
    1) EXT="mp4"; CONV_OPTS="-c:v libx264 -crf 23 -c:a aac -b:a 192k";;
    2) EXT="webm"; CONV_OPTS="-c:v libvpx-vp9 -crf 30 -b:v 0 -c:a libopus";;
    3) EXT="mp3"; CONV_OPTS="-c:a libmp3lame -b:a 192k";;
    4) EXT="m4a"; CONV_OPTS="-c:a aac -b:a 192k";;
    5) EXT="ogg"; CONV_OPTS="-c:a libvorbis -q:a 4";;
    6) EXT="opus"; CONV_OPTS="-c:a libopus -b:a 128k";;
    7) EXT="wav"; CONV_OPTS="";;
    8) EXT="flac"; CONV_OPTS="-c:a flac";;
    *) 
      if [[ "$L" == "ar" ]]; then
        echo "$ICON_ERROR خيار غير صالح. سيتم استخدام mp4."
      else
        echo "$ICON_ERROR Invalid choice. Using mp4."
      fi
      EXT="mp4"; CONV_OPTS="-c:v libx264 -crf 23 -c:a aac -b:a 192k";;
  esac
  
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_INFO تم اختيار الصيغة: $EXT"
  else
    echo "$ICON_INFO Selected format: $EXT"
  fi
  return 0
}

choose_video_quality() {
  if [[ "$L" == "ar" ]]; then
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│        $ICON_QUALITY جودة الفيديو          │"
    echo "├─────────────────────────────────────┤"
    echo "│  1) أفضل جودة متاحة                 │"
    echo "│  2) عالية (1080p)                   │"
    echo "│  3) متوسطة (720p)                   │"
    echo "│  4) منخفضة (480p)                   │"
    echo "└─────────────────────────────────────┘"
  else
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│        $ICON_QUALITY Video Quality         │"
    echo "├─────────────────────────────────────┤"
    echo "│  1) Best available                  │"
    echo "│  2) High (1080p)                    │"
    echo "│  3) Medium (720p)                   │"
    echo "│  4) Low (480p)                      │"
    echo "└─────────────────────────────────────┘"
  fi
  read -p "➤ " quality
  case $quality in
    1) FORMAT="bestvideo+bestaudio/best";;
    2) FORMAT="bv*[height<=1080]+ba/best[height<=1080]";;
    3) FORMAT="bv*[height<=720]+ba/best[height<=720]";;
    4) FORMAT="bv*[height<=480]+ba/best[height<=480]";;
    *) 
      if [[ "$L" == "ar" ]]; then
        echo "$ICON_ERROR خيار غير صالح. سيتم استخدام أفضل جودة."
      else
        echo "$ICON_ERROR Invalid choice. Using best quality."
      fi
      FORMAT="bestvideo+bestaudio/best";;
  esac
  
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_INFO تم اختيار الجودة: $quality"
  else
    echo "$ICON_INFO Selected quality: $quality"
  fi
  return 0
}

get_url() {
  local URL=""
  if [[ "$L" == "ar" ]]; then
    read -p "$ICON_URL أدخل رابط الفيديو أو الصوت: " URL
  else
    read -p "$ICON_URL Enter video or audio URL: " URL
  fi
  
  if [[ -z "$URL" ]]; then 
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_ERROR لم يتم إدخال رابط."
    else
      echo "$ICON_ERROR No URL entered."
    fi
    return 1
  fi
  
  # التحقق البسيط من صحة الرابط
  if [[ ! "$URL" =~ ^https?:// ]]; then
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_INFO الرابط لا يبدأ بـ http:// أو https://، جاري الإضافة..."
      URL="https://$URL"
    else
      echo "$ICON_INFO URL doesn't start with http:// or https://, adding..."
      URL="https://$URL"
    fi
  fi
  
  echo "$URL"
  return 0
}

# ----------------------------
# وظائف البرنامج الرئيسية
# ----------------------------
download_and_convert() {
  if [[ "$L" == "ar" ]]; then
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│      $ICON_SMART تنزيل وتحويل مباشر     │"
    echo "└─────────────────────────────────────┘"
  else
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│      $ICON_SMART Download & Convert    │"
    echo "└─────────────────────────────────────┘"
  fi
  
  local URL
  URL=$(get_url) || return 1
  
  # اختيار صيغة الإخراج أولاً
  choose_video_format || return 1
  
  # اختيار مسار الحفظ
  choose_save_path || return 1
  
  echo "$ICON_SMART جاري التحليل والتنزيل الذكي..."
  
  # الحصول على معلومات الملف أولاً
  echo "$ICON_INFO جاري جمع معلومات الملف..."
  local TITLE
  TITLE=$("$YTDLP" --get-title "$URL" 2>/dev/null | head -1)
  
  if [[ -z "$TITLE" ]]; then
    TITLE="media_$(date +%Y%m%d_%H%M%S)"
  else
    # تنظيف العنوان
    TITLE=$(echo "$TITLE" | tr -d '\n' | sed 's/[<>:"/\\|?*]//g' | sed 's/^ *//;s/ *$//')
  fi
  
  # إذا كان المطلوب فيديو، اختيار الجودة
  if [[ "$EXT" == "mp4" || "$EXT" == "webm" ]]; then
    choose_video_quality || return 1
    
    # تنزيل الفيديو مباشرة بالصيغة المطلوبة إن أمكن
    echo "$ICON_DOWNLOAD جاري تنزيل الفيديو بصيغة $EXT..."
    if [[ "$EXT" == "mp4" ]]; then
      "$YTDLP" -f "$FORMAT" --merge-output-format mp4 -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
    elif [[ "$EXT" == "webm" ]]; then
      "$YTDLP" -f "$FORMAT" --merge-output-format webm -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
    fi
  else
    # تنزيل الصوت
    echo "$ICON_AUDIO جاري تنزيل وتحويل الصوت إلى $EXT..."
    case $EXT in
      mp3) 
        "$YTDLP" -x --audio-format mp3 --audio-quality 0 -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
        ;;
      m4a)
        "$YTDLP" -x --audio-format m4a -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
        ;;
      ogg)
        "$YTDLP" -x --audio-format vorbis -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
        ;;
      opus)
        "$YTDLP" -x --audio-format opus -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
        ;;
      wav)
        "$YTDLP" -x --audio-format wav -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
        ;;
      flac)
        "$YTDLP" -x --audio-format flac -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
        ;;
    esac
  fi
  
  # البحث عن الملف الذي تم إنشاؤه
  local OUTPUT_FILE
  OUTPUT_FILE=$(find "$SAVE_PATH" -name "${TITLE}*" -type f -newer /proc/self 2>/dev/null | head -1)
  
  if [[ -f "$OUTPUT_FILE" ]]; then
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_SUCCESS تم تنزيل وتحويل الملف بنجاح!"
      echo "📄 الملف: $OUTPUT_FILE"
      echo "📊 الحجم: $(du -h "$OUTPUT_FILE" | cut -f1)"
    else
      echo "$ICON_SUCCESS File downloaded and converted successfully!"
      echo "📄 File: $OUTPUT_FILE"
      echo "📊 Size: $(du -h "$OUTPUT_FILE" | cut -f1)"
    fi
    
    # فتح المجلد
    if [[ -n "$FILE_MANAGER" ]]; then
      if [[ "$L" == "ar" ]]; then
        read -p "هل تريد فتح مجلد الحفظ؟ [y/N]: " open_folder
      else
        read -p "Open download folder? [y/N]: " open_folder
      fi
      if [[ "${open_folder:-}" =~ ^[Yy]$ ]]; then
        $FILE_MANAGER "$SAVE_PATH"
      fi
    fi
  else
    # البحث بأي اسم
    OUTPUT_FILE=$(find "$SAVE_PATH" -type f -newer /proc/self 2>/dev/null | head -1)
    if [[ -f "$OUTPUT_FILE" ]]; then
      if [[ "$L" == "ar" ]]; then
        echo "$ICON_SUCCESS تم التنزيل بنجاح!"
        echo "📄 الملف: $OUTPUT_FILE"
      else
        echo "$ICON_SUCCESS Download completed!"
        echo "📄 File: $OUTPUT_FILE"
      fi
    else
      if [[ "$L" == "ar" ]]; then
        echo "$ICON_INFO تم إنهاء عملية التنزيل. تحقق من مجلد الحفظ: $SAVE_PATH"
      else
        echo "$ICON_INFO Download process completed. Check the save folder: $SAVE_PATH"
      fi
    fi
  fi
  
  return 0
}

download_video() {
  if [[ "$L" == "ar" ]]; then
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│      $ICON_DOWNLOAD تنزيل فيديو         │"
    echo "└─────────────────────────────────────┘"
  else
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│      $ICON_DOWNLOAD Download Video     │"
    echo "└─────────────────────────────────────┘"
  fi
  
  local URL
  URL=$(get_url) || return 1
  
  choose_video_quality || return 1
  choose_save_path || return 1
  
  echo "$ICON_DOWNLOAD جاري تحميل الفيديو..."
  "$YTDLP" -f "$FORMAT" -o "$SAVE_PATH/%(title)s.%(ext)s" "$URL"
  
  # العثور على الملف المنزل
  local OUTPUT_FILE
  OUTPUT_FILE=$(find "$SAVE_PATH" -type f -newer /proc/self 2>/dev/null | head -1)
  
  if [[ -f "$OUTPUT_FILE" ]]; then
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_SUCCESS تم التحميل بنجاح!"
      echo "📄 الملف: $OUTPUT_FILE"
      echo "📊 الحجم: $(du -h "$OUTPUT_FILE" | cut -f1)"
    else
      echo "$ICON_SUCCESS Download completed!"
      echo "📄 File: $OUTPUT_FILE"
      echo "📊 Size: $(du -h "$OUTPUT_FILE" | cut -f1)"
    fi
  else
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_INFO تم إنهاء عملية التنزيل."
    else
      echo "$ICON_INFO Download process completed."
    fi
  fi
  
  if [[ -n "$FILE_MANAGER" ]]; then
    if [[ "$L" == "ar" ]]; then
      read -p "هل تريد فتح مجلد الحفظ؟ [y/N]: " open_folder
    else
      read -p "Open download folder? [y/N]: " open_folder
    fi
    if [[ "${open_folder:-}" =~ ^[Yy]$ ]]; then
      $FILE_MANAGER "$SAVE_PATH"
    fi
  fi
}

download_audio() {
  if [[ "$L" == "ar" ]]; then
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│      $ICON_AUDIO تنزيل صوت            │"
    echo "└─────────────────────────────────────┘"
  else
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│      $ICON_AUDIO Download Audio       │"
    echo "└─────────────────────────────────────┘"
  fi
  
  local URL
  URL=$(get_url) || return 1
  
  choose_save_path || return 1
  
  echo "$ICON_AUDIO جاري تحميل الصوت بصيغة mp3..."
  "$YTDLP" -x --audio-format mp3 --audio-quality 0 -o "$SAVE_PATH/%(title)s.%(ext)s" "$URL"
  
  local OUTPUT_FILE
  OUTPUT_FILE=$(find "$SAVE_PATH" -type f -name "*.mp3" -newer /proc/self 2>/dev/null | head -1)
  
  if [[ -f "$OUTPUT_FILE" ]]; then
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_SUCCESS تم التحميل بنجاح!"
      echo "📄 الملف: $OUTPUT_FILE"
      echo "📊 الحجم: $(du -h "$OUTPUT_FILE" | cut -f1)"
    else
      echo "$ICON_SUCCESS Download completed!"
      echo "📄 File: $OUTPUT_FILE"
      echo "📊 Size: $(du -h "$OUTPUT_FILE" | cut -f1)"
    fi
  else
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_INFO تم إنهاء عملية التنزيل."
    else
      echo "$ICON_INFO Download process completed."
    fi
  fi
  
  if [[ -n "$FILE_MANAGER" ]]; then
    if [[ "$L" == "ar" ]]; then
      read -p "هل تريد فتح مجلد الحفظ؟ [y/N]: " open_folder
    else
      read -p "Open download folder? [y/N]: " open_folder
    fi
    if [[ "${open_folder:-}" =~ ^[Yy]$ ]]; then
      $FILE_MANAGER "$SAVE_PATH"
    fi
  fi
}

convert_media() {
  if [[ "$L" == "ar" ]]; then
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│      $ICON_CONVERT تحويل وسائط        │"
    echo "└─────────────────────────────────────┘"
  else
    echo ""
    echo "┌─────────────────────────────────────┐"
    echo "│      $ICON_CONVERT Convert Media      │"
    echo "└─────────────────────────────────────┘"
  fi
  
  local FILE
  FILE=$(choose_file_path) || return 1
  
  choose_video_format || return 1
  choose_save_path || return 1
  
  BASENAME=$(basename "$FILE")
  NAME="${BASENAME%.*}"
  OUTPUT_FILE="$SAVE_PATH/${NAME}.${EXT}"
  
  echo "$ICON_CONVERT جاري التحويل..."
  
  # التحويل مع عرض التقدم
  if command -v pv &>/dev/null; then
    pv "$FILE" | ffmpeg -i pipe:0 $CONV_OPTS "$OUTPUT_FILE" 2>/dev/null
  else
    ffmpeg -i "$FILE" $CONV_OPTS "$OUTPUT_FILE" 2>/dev/null
  fi
  
  if [[ $? -eq 0 ]] && [[ -f "$OUTPUT_FILE" ]]; then
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_SUCCESS تم التحويل بنجاح!"
      echo "📄 الملف المحول: $OUTPUT_FILE"
      echo "📊 الحجم الأصلي: $(du -h "$FILE" | cut -f1)"
      echo "📊 الحجم الجديد: $(du -h "$OUTPUT_FILE" | cut -f1)"
    else
      echo "$ICON_SUCCESS Conversion completed!"
      echo "📄 Converted file: $OUTPUT_FILE"
      echo "📊 Original size: $(du -h "$FILE" | cut -f1)"
      echo "📊 New size: $(du -h "$OUTPUT_FILE" | cut -f1)"
    fi
  else
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_ERROR فشل التحويل."
    else
      echo "$ICON_ERROR Conversion failed."
    fi
    return 1
  fi
  
  if [[ -n "$FILE_MANAGER" ]]; then
    if [[ "$L" == "ar" ]]; then
      read -p "هل تريد فتح مجلد الحفظ؟ [y/N]: " open_folder
    else
      read -p "Open download folder? [y/N]: " open_folder
    fi
    if [[ "${open_folder:-}" =~ ^[Yy]$ ]]; then
      $FILE_MANAGER "$SAVE_PATH"
    fi
  fi
  
  return 0
}

extra_download_options() {
  while true; do
    if [[ "$L" == "ar" ]]; then
      echo ""
      echo "┌─────────────────────────────────────┐"
      echo "│      $ICON_EXTRA خيارات تنزيل أخرى     │"
      echo "├─────────────────────────────────────┤"
      echo "│  1) تنزيل قائمة تشغيل كاملة        │"
      echo "│  2) تنزيل مقاطع من قناة            │"
      echo "│  3) تنزيل الترجمات فقط             │"
      echo "│  4) تنزيل الصور المصغرة فقط        │"
      echo "│  5) تنزيل شامل (كل المرفقات)      │"
      echo "│  $ICON_BACK 6) رجوع                     │"
      echo "└─────────────────────────────────────┘"
      read -p "اختر خيارًا [1-6]: " extra_opt
    else
      echo ""
      echo "┌─────────────────────────────────────┐"
      echo "│      $ICON_EXTRA Extra Download Options │"
      echo "├─────────────────────────────────────┤"
      echo "│  1) Download complete playlist      │"
      echo "│  2) Download from channel           │"
      echo "│  3) Download subtitles only         │"
      echo "│  4) Download thumbnails only        │"
      echo "│  5) Complete package download       │"
      echo "│  $ICON_BACK 6) Back                      │"
      echo "└─────────────────────────────────────┘"
      read -p "Choose an option [1-6]: " extra_opt
    fi

    case $extra_opt in
      1)
        local URL
        URL=$(get_url) || continue
        choose_save_path || continue
        echo "$ICON_DOWNLOAD جاري تنزيل قائمة التشغيل..."
        "$YTDLP" -o "$SAVE_PATH/%(playlist_title)s/%(title)s.%(ext)s" "$URL"
        ;;
      2)
        local URL
        URL=$(get_url) || continue
        choose_save_path || continue
        echo "$ICON_DOWNLOAD جاري تنزيل مقاطع القناة..."
        "$YTDLP" -o "$SAVE_PATH/%(uploader)s/%(title)s.%(ext)s" "$URL"
        ;;
      3)
        local URL
        URL=$(get_url) || continue
        choose_save_path || continue
        echo "$ICON_DOWNLOAD جاري تنزيل الترجمات..."
        "$YTDLP" --write-auto-sub --skip-download -o "$SAVE_PATH/%(title)s" "$URL"
        ;;
      4)
        local URL
        URL=$(get_url) || continue
        choose_save_path || continue
        echo "$ICON_DOWNLOAD جاري تنزيل الصور المصغرة..."
        "$YTDLP" --write-thumbnail --skip-download -o "$SAVE_PATH/%(title)s" "$URL"
        ;;
      5)
        local URL
        URL=$(get_url) || continue
        choose_save_path || continue
        
        echo "$ICON_COMPLETE جاري التنزيل الشامل..."
        local COMPLETE_DIR="$SAVE_PATH/complete_$(date +%Y%m%d_%H%M%S)"
        mkdir -p "$COMPLETE_DIR"
        
        "$YTDLP" -f "bestvideo+bestaudio/best" \
          --write-thumbnail \
          --write-sub --write-auto-sub --all-subs \
          --write-description --write-info-json \
          --write-annotations \
          -o "$COMPLETE_DIR/%(title)s.%(ext)s" \
          "$URL"
        
        echo "$ICON_SUCCESS تم التنزيل الشامل في: $COMPLETE_DIR"
        ;;
      6) return 0;;
      *) 
        if [[ "$L" == "ar" ]]; then
          echo "$ICON_ERROR خيار غير صالح."
        else
          echo "$ICON_ERROR Invalid option."
        fi
        ;;
    esac
    
    if [[ -n "$FILE_MANAGER" ]]; then
      if [[ "$L" == "ar" ]]; then
        read -p "هل تريد فتح مجلد الحفظ؟ [y/N]: " open_folder
      else
        read -p "Open download folder? [y/N]: " open_folder
      fi
      if [[ "${open_folder:-}" =~ ^[Yy]$ ]]; then
        $FILE_MANAGER "$SAVE_PATH"
      fi
    fi
  done
}

settings_menu() {
  while true; do
    if [[ "$L" == "ar" ]]; then
      echo ""
      echo "┌─────────────────────────────────────┐"
      echo "│          $ICON_SETTINGS الإعدادات    │"
      echo "├─────────────────────────────────────┤"
      echo "│  1) تغيير اللغة                     │"
      echo "│  2) تحديث yt-dlp                    │"
      echo "│  3) إصلاح اختصار سطح المكتب        │"
      echo "│  4) إلغاء التثبيت                   │"
      echo "│  $ICON_BACK 5) رجوع                 │"
      echo "└─────────────────────────────────────┘"
      read -p "اختر خيارًا [1-5]: " settings_opt
    else
      echo ""
      echo "┌─────────────────────────────────────┐"
      echo "│          $ICON_SETTINGS Settings    │"
      echo "├─────────────────────────────────────┤"
      echo "│  1) Change language                 │"
      echo "│  2) Update yt-dlp                   │"
      echo "│  3) Fix desktop shortcut            │"
      echo "│  4) Uninstall                       │"
      echo "│  $ICON_BACK 5) Back                 │"
      echo "└─────────────────────────────────────┘"
      read -p "Choose an option [1-5]: " settings_opt
    fi

    case $settings_opt in
      1) toggle_lang;;
      2) update_yt_dlp;;
      3) 
        # إصلاح اختصار سطح المكتب
        DESKTOP_DIR="$HOME/.local/share/applications"
        mkdir -p "$DESKTOP_DIR"
        
        cat > "$DESKTOP_DIR/gmd.desktop" <<EOF
[Desktop Entry]
Name=GMD - GNU Media Downloader
Comment=Download and convert media
Exec=bash -c "$HOME/.local/bin/gmd"
Icon=system-search
Terminal=true
Type=Application
Categories=Utility;Network;AudioVideo;Audio;Video;
EOF
        
        chmod +x "$DESKTOP_DIR/gmd.desktop"
        
        if command -v update-desktop-database &>/dev/null; then
          update-desktop-database ~/.local/share/applications
        fi
        
        if [[ "$L" == "ar" ]]; then
          echo "$ICON_SUCCESS تم إصلاح اختصار سطح المكتب!"
        else
          echo "$ICON_SUCCESS Desktop shortcut fixed!"
        fi
        ;;
      4) uninstall_gmd;;
      5) return 0;;
      *) 
        if [[ "$L" == "ar" ]]; then
          echo "$ICON_ERROR خيار غير صالح."
        else
          echo "$ICON_ERROR Invalid option."
        fi
        ;;
    esac
  done
}

install_desktop_shortcut() {
  DESKTOP_DIR="$HOME/.local/share/applications"
  mkdir -p "$DESKTOP_DIR"
  
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_INSTALL تثبيت اختصار سطح المكتب..."
  else
    echo "$ICON_INSTALL Installing desktop shortcut..."
  fi
  
  cat > "$DESKTOP_DIR/gmd.desktop" <<EOF
[Desktop Entry]
Name=GMD - GNU Media Downloader
Comment=Download and convert media
Exec=bash -c "$HOME/.local/bin/gmd"
Icon=system-search
Terminal=true
Type=Application
Categories=Utility;Network;AudioVideo;Audio;Video;
EOF
  
  chmod +x "$DESKTOP_DIR/gmd.desktop"
  
  if command -v update-desktop-database &>/dev/null; then
    update-desktop-database ~/.local/share/applications
  fi
  
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_SUCCESS تم إنشاء اختصار سطح المكتب!"
    echo "📁 يمكنك الآن العثور على التطبيق في قائمة التطبيقات"
  else
    echo "$ICON_SUCCESS Desktop shortcut created!"
    echo "📁 You can now find the app in the applications menu"
  fi
}

uninstall_gmd() {
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_UNINSTALL بدء عملية إلغاء التثبيت..."
    read -p "هل أنت متأكد من إلغاء تثبيت GMD؟ [y/N]: " confirm
  else
    echo "$ICON_UNINSTALL Starting uninstall process..."
    read -p "Are you sure you want to uninstall GMD? [y/N]: " confirm
  fi

  if [[ ! "${confirm:-}" =~ ^[Yy]$ ]]; then
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_INFO تم إلغاء العملية."
    else
      echo "$ICON_INFO Operation cancelled."
    fi
    return
  fi

  if [[ -f "$YTDLP" ]]; then
    if [[ "$L" == "ar" ]]; then
      read -p "هل تريد أيضًا إزالة yt-dlp؟ [y/N]: " remove_ytdlp
    else
      read -p "Do you want to remove yt-dlp too? [y/N]: " remove_ytdlp
    fi

    if [[ "${remove_ytdlp:-}" =~ ^[Yy]$ ]]; then
      rm -f "$YTDLP"
      if [[ "$L" == "ar" ]]; then
        echo "$ICON_SUCCESS تمت إزالة yt-dlp"
      else
        echo "$ICON_SUCCESS Removed yt-dlp"
      fi
    fi
  fi

  if [[ -f "$SELF_PATH" ]]; then
    rm -f "$SELF_PATH"
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_SUCCESS تمت إزالة الملف التنفيذي"
    else
      echo "$ICON_SUCCESS Removed executable"
    fi
  fi

  if [[ -f "$HOME/.local/share/applications/gmd.desktop" ]]; then
    rm -f "$HOME/.local/share/applications/gmd.desktop"
    if [[ "$L" == "ar" ]]; then
      echo "$ICON_SUCCESS تمت إزالة اختصار سطح المكتب"
    else
      echo "$ICON_SUCCESS Removed desktop shortcut"
    fi
  fi

  if command -v update-desktop-database &>/dev/null; then
    update-desktop-database ~/.local/share/applications 2>/dev/null
  fi

  if [[ "$L" == "ar" ]]; then
    echo "$ICON_SUCCESS تم إلغاء تثبيت GMD بنجاح!"
  else
    echo "$ICON_SUCCESS GMD uninstalled successfully!"
  fi
  exit 0
}

# ----------------------------
# القائمة الرئيسية
# ----------------------------
show_main_menu() {
  echo ""
  echo "┌─────────────────────────────────────┐"
  if [[ "$L" == "ar" ]]; then
    echo "│          GMD - v1.92              │"
    echo "│    منزل وسائط جنو                  │"
    echo "├─────────────────────────────────────┤"
    echo "│  $ICON_DOWNLOAD 1) تنزيل فيديو            │"
    echo "│  $ICON_SMART 2) تنزيل وتحويل مباشر       │"
    echo "│  $ICON_AUDIO 3) تنزيل صوت                 │"
    echo "│  $ICON_CONVERT 4) تحويل وسائط             │"
    echo "│  $ICON_EXTRA 5) خيارات تنزيل أخرى         │"
    echo "│  $ICON_SETTINGS 6) إعدادات                │"
    echo "│  $ICON_INSTALL 7) تثبيت اختصار سطح المكتب │"
    echo "│  $ICON_EXIT 0) خروج                       │"
    echo "└─────────────────────────────────────┘"
    read -p "اختر خيارًا [0-7]: " option
  else
    echo "│          GMD - v1.92                │"
    echo "│    GNU MEDIA DOWNLOADER             │"
    echo "├─────────────────────────────────────┤"
    echo "│  $ICON_DOWNLOAD 1) Download Video         │"
    echo "│  $ICON_SMART 2) Download & Convert Direct │"
    echo "│  $ICON_AUDIO 3) Download Audio            │"
    echo "│  $ICON_CONVERT 4) Convert Media           │"
    echo "│  $ICON_EXTRA 5) Extra Download Options    │"
    echo "│  $ICON_SETTINGS 6) Settings               │"
    echo "│  $ICON_INSTALL 7) Install Desktop Shortcut│"
    echo "│  $ICON_EXIT 0) Exit                       │"
    echo "└─────────────────────────────────────┘"
    read -p "Choose an option [0-7]: " option
  fi
}

# ----------------------------
# التشغيل الرئيسي
# ----------------------------
main() {
  # تثبيت yt-dlp إذا لم يكن مثبتاً
  install_yt_dlp
  
  while true; do
    show_main_menu
    case $option in
      1) download_video;;
      2) download_and_convert;;
      3) download_audio;;
      4) convert_media;;
      5) extra_download_options;;
      6) settings_menu;;
      7) install_desktop_shortcut;;
      0)
        if [[ "$L" == "ar" ]]; then
          echo "$ICON_EXIT مع السلامة!"
        else
          echo "$ICON_EXIT Goodbye!"
        fi
        exit 0;;
      *) 
        if [[ "$L" == "ar" ]]; then
          echo "$ICON_ERROR خيار غير صالح. الرجاء المحاولة مرة أخرى."
        else
          echo "$ICON_ERROR Invalid option. Please try again."
        fi;;
    esac
    echo ""
    if [[ "$L" == "ar" ]]; then
      read -p "اضغط Enter للمتابعة..." dummy
    else
      read -p "Press Enter to continue..." dummy
    fi
    clear
    show_logo
  done
}

# بدء البرنامج
main
[file content end]
