  clear
  show_logo
  if [[ "$L" == "ar" ]]; then
cat <<EOF
============ $ICON_CONVERT تحويل وسائط =============
1) اختيار ملف (تصفح أو إدخال يدوي)
2) اختيار مجلد هدف (افتراضي: $SAVE_PATH)
3) اختيار صيغة التحويل (mp3/ogg/mp4/webm/mkv/wav/flac)
4) خيارات جودة متقدمة
5) إدخال اسم ملف جديد (اختياري)
