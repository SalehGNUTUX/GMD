#!/bin/bash
# GMD - GNU Media Downloader v1.9
# by gnutux / SalehGNUTUX

set -euo pipefail

# ----------------------------
# إعداد اللغة (قابل للتغيير)
# ----------------------------
SYS_LANG="${LANG:0:2}"
LANGUAGE="${SYS_LANG}"   # يأخذ لغة النظام افتراضياً
L="ar"
set_lang() {
  if [[ "$LANGUAGE" == "ar" ]]; then
    L="ar"
  else
    L="en"
  fi
}
set_lang

CHECKED_LANG_ONCE=""   # variable used to show install prompt only once

# ----------------------------
# الشعار
# ----------------------------
show_logo() {
if [[ "$L" == "ar" ]]; then
echo "
   ____   __  __   ____  
  / ___| |  \/  | |  _ \ 
 | |  _  | |\/| | | | | |
 | |_| | | |  | | | |_| |
  \____| |_|  |_| |____/ 
-------------------------
   GNU MEDIA DOWNLOADER
-------------------------
       » BY GNUTUX «
         » v1.9 «
"
else
echo "
   ____   __  __   ____  
  / ___| |  \/  | |  _ \ 
 | |  _  | |\/| | | | | |
 | |_| | | |  | | | |_| |
  \____| |_|  |_| |____/ 
-------------------------
   GNU MEDIA DOWNLOADER
-------------------------
       » BY GNUTUX «
         » v1.9 «
"
fi
}

# ----------------------------
# أيقونات وجماليات
# ----------------------------
ICON_DOWNLOAD="⬇️"
ICON_AUDIO="🎵"
ICON_CONVERT="🔄"
ICON_INSTALL="📁"
ICON_UNINSTALL="🗑️"
ICON_EXIT="🚪"
ICON_VIDEO="🎬"
ICON_SETTINGS="⚙️"
ICON_OTHER="⚡"
ICON_SUCCESS="✅"
ICON_ERROR="❌"
ICON_INFO="ℹ️"
ICON_FOLDER="📂"
ICON_FILE="📄"
ICON_URL="🌐"
ICON_QUALITY="🎞️"
ICON_FORMAT="🎧"
ICON_LANG="🌐"

# ----------------------------
# خيار التبديل بين اللغتين
# ----------------------------
toggle_lang() {
  if [[ "$LANGUAGE" == "ar" ]]; then
    LANGUAGE="en"; L="en"
  else
    LANGUAGE="ar"; L="ar"
  fi
  set_lang
  show_logo
  echo ""
  if [[ "$L" == "ar" ]]; then
    echo "تم تغيير اللغة إلى العربية."
  else
    echo "Language switched to English."
  fi
}

choose_language_menu() {
  clear
  echo "$ICON_LANG"
  if [[ "$L" == "ar" ]]; then
    echo "اختر اللغة:"
    echo "1) العربية (AR)"
    echo "2) English (EN)"
    echo "0) عودة"
  else
    echo "Choose language:"
    echo "1) Arabic (AR)"
    echo "2) الإنجليزية (EN)"
    echo "0) Back"
  fi
  read -p "➤ " lang_ch
  case $lang_ch in
    1) LANGUAGE="ar"; set_lang;;
    2) LANGUAGE="en"; set_lang;;
    0) return;;
    *) choose_language_menu;;
  esac
  show_logo
}

# ----------------------------
# المسارات الأساسية والإعدادات
# ----------------------------
BIN_DIR="$HOME/.local/bin"
mkdir -p "$BIN_DIR"
SELF_PATH="$BIN_DIR/gmd"
YTDLP="$BIN_DIR/yt-dlp"
FILE_MANAGER=$(command -v xdg-open || command -v nemo || command -v nautilus || echo "")
SAVE_PATH="$HOME/GMD"
UPDATE_MARKER="$HOME/.config/gmd_last_update"
mkdir -p "$(dirname "$UPDATE_MARKER")"
DEFAULT_SAVE_PATH="$HOME/GMD"
touch "$UPDATE_MARKER"

# تحميل الإعدادات (مستقبلاً يمكن الحفظ في ملف إعدادات خاص)

# ----------------------------
# التحقق من التبعيات
# ----------------------------
REQUIRED_CMDS=(ffmpeg zenity curl)
missing=()
for cmd in "${REQUIRED_CMDS[@]}"; do
    if ! command -v "$cmd" &>/dev/null; then
        missing+=("$cmd")
    fi
done

install_deps() {
  if [ "${#missing[@]}" -eq 0 ]; then return; fi
  echo "$ICON_INFO محاولة تثبيت التبعيات المطلوبة تلقائيًا..."
  if command -v apt &>/dev/null; then
    sudo apt update
    for m in "${missing[@]}"; do sudo apt install -y "$m"; done
  elif command -v dnf &>/dev/null; then
    sudo dnf install -y "${missing[@]}"
  elif command -v pacman &>/dev/null; then
    sudo pacman -Sy --noconfirm "${missing[@]}"
  else
    echo "$ICON_ERROR لا يمكن اكتشاف مدير الحزم تلقائيًا. يرجى تثبيت: ${missing[*]}"
    exit 1
  fi
}

if (( ${#missing[@]} > 0 )); then
  echo "$ICON_ERROR التبعيات التالية غير موجودة: ${missing[*]}"
  read -p "هل ترغب بمحاولة تثبيتها تلقائيًا؟ [y/N]: " try_install
  if [[ "${try_install:-}" =~ ^[Yy]$ ]]; then install_deps; else exit 1; fi
fi

# ----------------------------
# تثبيت / تحديث yt-dlp
# ----------------------------
check_system_ytdlp() {
    local system_ytdlp=$(command -v yt-dlp)
    if [[ -n "$system_ytdlp" && "$system_ytdlp" != "$YTDLP" ]]; then
        echo "$ICON_INFO Found yt-dlp installed systemwide: $system_ytdlp"
        echo "$ICON_INFO The repo version may be outdated."
        if [[ "$L" == "ar" ]]; then
            read -p "هل تريد إزالة نسخة النظام واستخدام الأحدث من GitHub؟ [y/N]: " remove_system
        else
            read -p "Do you want to remove system version and use the latest from GitHub? [y/N]: " remove_system
        fi
        if [[ "${remove_system:-}" =~ ^[Yy]$ ]]; then
            echo "$ICON_UNINSTALL Removing system yt-dlp..."
            if command -v apt &>/dev/null; then
                sudo apt remove -y yt-dlp
            elif command -v dnf &>/dev/null; then
                sudo dnf remove -y yt-dlp
            elif command -v pacman &>/dev/null; then
                sudo pacman -Rs --noconfirm yt-dlp
            else
                echo "$ICON_INFO Please remove yt-dlp manually."
            fi
        else
            echo "$ICON_INFO Will use system yt-dlp (note: may be outdated)"
            YTDLP="$system_ytdlp"
        fi
    fi
}

install_yt_dlp() {
  check_system_ytdlp
  if [ -x "$YTDLP" ]; then
    echo "$ICON_SUCCESS yt-dlp exists."
  else
    echo "$ICON_DOWNLOAD Installing yt-dlp from GitHub..."
    curl -L "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" -o "$YTDLP"
    chmod a+rx "$YTDLP"
    echo "$ICON_SUCCESS yt-dlp installed."
  fi
}

update_yt_dlp() {
  echo "$ICON_CONVERT Updating yt-dlp..."
  "$YTDLP" -U || echo "⚠️ Update failed, will use existing version."
}

# ----------------------------
# تحديث البرنامج نفسه تلقائيًا
# ----------------------------
REPO_RAW_URL="https://raw.githubusercontent.com/SalehGNUTUX/GMD/main/GMD%20APPIAMGE%20BIULD/GMD.AppDir/usr/bin/gmd"
self_update() {
  local now last diff TMP_FILE
  now=$(date +%s)
  last=$(cat "$UPDATE_MARKER" 2>/dev/null || echo 0)
  diff=$(( (now - last) / 86400 ))
  if (( diff >= 7 )); then
    echo "$ICON_INFO Checking for updates..."
    TMP_FILE=$(mktemp)
    if curl -L "$REPO_RAW_URL" -o "$TMP_FILE" 2>/dev/null; then
      if ! cmp -s "$SELF_PATH" "$TMP_FILE"; then
        echo "$ICON_DOWNLOAD Updating GMD to latest version..."
        chmod a+rx "$TMP_FILE"
        mv "$TMP_FILE" "$SELF_PATH"
        echo "$now" > "$UPDATE_MARKER"
        echo "$ICON_SUCCESS Updated GMD!"
        exec "$SELF_PATH" "$@"
      else
        rm -f "$TMP_FILE"
        echo "$ICON_INFO GMD is already up-to-date."
      fi
    else
      rm -f "$TMP_FILE"
      echo "⚠️ Couldn't check for updates."
    fi
  else
    echo "$ICON_INFO Recent update check."
  fi
}

press_enter() {
if [[ "$L" == "ar" ]]; then
  read -p "اضغط Enter للمتابعة ..." dummy
else
  read -p "Press Enter to continue ..." dummy
fi
}

# ----------------------------
# القائمة الرئيسية
# ----------------------------
main_menu() {
  clear
  show_logo
  echo ""
  if [[ "$L" == "ar" ]]; then
cat <<EOF
========================================
  القائمة الرئيسية لـ GMD
========================================
$ICON_DOWNLOAD  1) تنزيل فيديو
$ICON_AUDIO     2) تنزيل صوت
$ICON_CONVERT   3) تحويل وسائط
$ICON_OTHER     4) خيارات تنزيل أخرى
$ICON_SETTINGS  5) settings/إعدادات
$ICON_INSTALL   6) تثبيت اختصار سطح المكتب
$ICON_EXIT      0) خروج
========================================
EOF
    read -p "اختر خياراً [0-6]: " option
  else
cat <<EOF
========================================
   GMD Main Menu
========================================
$ICON_DOWNLOAD  1) Download Video
$ICON_AUDIO     2) Download Audio
$ICON_CONVERT   3) Convert Media
$ICON_OTHER     4) Other Download Options
$ICON_SETTINGS  5) settings/إعدادات
$ICON_INSTALL   6) Install Desktop Shortcut
$ICON_EXIT      0) Exit
========================================
EOF
    read -p "Choose an option [0-6]: " option
  fi

  case $option in
    1) download_video_menu;;
    2) download_audio_menu;;
    3) convert_media_menu;;
    4) other_download_menu;;
    5) settings_menu;;
    6) install_desktop_shortcut; press_enter; main_menu;;
    0) exit_program;;
    *) main_menu;;
  esac
}

# ----------------------------
# قوائم فرعية
# ----------------------------

download_video_menu() {
  clear
  show_logo
  if [[ "$L" == "ar" ]]; then
cat <<EOF
============ $ICON_DOWNLOAD تنزيل فيديو =============
1) إدخال رابط فيديو/قائمة تشغيل
2) اختيار مجلد الحفظ (افتراضي: $SAVE_PATH)
3) اختيار الجودة (عالية جدا/عالية/متوسطة/منخفضة/أفضل)
4) تحميل الترجمة (نعم/لا مع اختيار اللغة)
5) تحميل الصورة المصغرة (نعم/لا)
6) خيارات إضافية
0) عودة
EOF
  else
cat <<EOF
============ $ICON_DOWNLOAD Download Video ============
1) Enter video/playlist URL
2) Choose save folder (default: $SAVE_PATH)
3) Select quality (very high/high/medium/low/best)
4) Download subtitles? (yes/no & select language)
5) Download thumbnail? (yes/no)
6) Advanced options
0) Back
EOF
 fi
 read -p "[0-6]: " subopt
 [[ "$subopt" == 0 ]] && main_menu || download_video_menu  # اربط هنا دوال التنفيذ الحقيقية حسب الحاجة
}

