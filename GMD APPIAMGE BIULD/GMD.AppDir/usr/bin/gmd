#!/bin/bash
# GMD - GNU Media Downloader v1.5
# by gnutux
set -euo pipefail

clear
echo "
   ____   __  __   ____
  / ___| |  \/  | |  _ \\
 | |  _  | |\/| | | | | |
 | |_| | | |  | | | |_| |
  \\____| |_|  |_| |____/
-------------------------
   GNU MEDIA DOWNLOADER
-------------------------
       » BY GNUTUX «
         » v1.5 «
"

# ----------------------------
# المسارات الأساسية
# ----------------------------
BIN_DIR="$HOME/.local/bin"
mkdir -p "$BIN_DIR"
SELF_PATH="$BIN_DIR/gmd"
YTDLP="$BIN_DIR/yt-dlp"
FILE_MANAGER=$(command -v xdg-open || command -v nemo || command -v nautilus)
SAVE_PATH=""
UPDATE_MARKER="$HOME/.config/gmd_last_update"
mkdir -p "$(dirname "$UPDATE_MARKER")"

# ----------------------------
# الإعدادات الجمالية والأيقونات
# ----------------------------
ICON_DOWNLOAD="⬇️"
ICON_CONVERT="🔄"
ICON_INSTALL="📁"
ICON_UNINSTALL="🗑️"
ICON_EXIT="🚪"
ICON_VIDEO="🎬"
ICON_AUDIO="🎵"
ICON_SETTINGS="⚙️"
ICON_SUCCESS="✅"
ICON_ERROR="❌"
ICON_INFO="ℹ️"
ICON_FOLDER="📂"
ICON_FILE="📄"
ICON_URL="🌐"
ICON_QUALITY="🎞️"
ICON_FORMAT="🎧"

# ----------------------------
# التحقق من التبعيات
# ----------------------------
REQUIRED_CMDS=(ffmpeg zenity curl)
missing=()
for cmd in "${REQUIRED_CMDS[@]}"; do
    if ! command -v "$cmd" &>/dev/null; then
        missing+=("$cmd")
    fi
done

install_deps() {
  if [ "${#missing[@]}" -eq 0 ]; then return; fi
  echo "$ICON_INFO محاولة تثبيت التبعيات المطلوبة تلقائيًا..."
  if command -v apt &>/dev/null; then
    sudo apt update
    for m in "${missing[@]}"; do sudo apt install -y "$m"; done
  elif command -v dnf &>/dev/null; then
    sudo dnf install -y "${missing[@]}"
  elif command -v pacman &>/dev/null; then
    sudo pacman -Sy --noconfirm "${missing[@]}"
  else
    echo "$ICON_ERROR لا يمكن اكتشاف مدير الحزم تلقائيًا. يرجى تثبيت: ${missing[*]}"
    exit 1
  fi
}

if (( ${#missing[@]} > 0 )); then
  echo "$ICON_ERROR التبعيات التالية غير موجودة: ${missing[*]}"
  read -p "هل ترغب بمحاولة تثبيتها تلقائيًا؟ [y/N]: " try_install
  if [[ "$try_install" =~ ^[Yy]$ ]]; then install_deps; else exit 1; fi
fi

# ----------------------------
# تثبيت / تحديث yt-dlp
# ----------------------------
install_yt_dlp() {
  if [ -x "$YTDLP" ]; then
    echo "$ICON_SUCCESS yt-dlp موجود بالفعل."
  else
    echo "$ICON_DOWNLOAD تثبيت yt-dlp من GitHub..."
    if command -v aria2c &>/dev/null; then
      aria2c "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" --dir "$BIN_DIR" -o yt-dlp
    elif command -v curl &>/dev/null; then
      curl -L "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" -o "$YTDLP"
    elif command -v wget &>/dev/null; then
      wget "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" -O "$YTDLP"
    else
      echo "$ICON_ERROR لا يوجد أداة تحميل (aria2c, curl, wget)."
      exit 1
    fi
    chmod a+rx "$YTDLP"
    echo "$ICON_SUCCESS تم تثبيت yt-dlp بنجاح."
  fi
}

update_yt_dlp() {
  echo "$ICON_CONVERT تحديث yt-dlp..."
  "$YTDLP" -U || echo "⚠️ فشل التحديث، سيتم استخدام النسخة الحالية."
}

# ----------------------------
# تحديث البرنامج نفسه تلقائيًا
# ----------------------------
self_update() {
  echo "$ICON_INFO التحديث التلقائي موقف مؤقتًا للتصحيح."
  return 0
}

# ----------------------------
# التحقق من اللغة
# ----------------------------
LANGUAGE=$(locale | grep LANG= | cut -d= -f2 | cut -d_ -f1)
if [[ "$LANGUAGE" == "ar" ]]; then
  L=ar
else
  L=en
fi

# ----------------------------
# وظائف اختيار المجلد / الملف
# ----------------------------
choose_save_path() {
  if command -v zenity &>/dev/null; then
    if [[ "$L" == "ar" ]]; then
      SAVE_PATH=$(zenity --file-selection --directory --title="اختر مجلد الحفظ")
    else
      SAVE_PATH=$(zenity --file-selection --directory --title="Choose download folder")
    fi
  fi
  if [[ -z "$SAVE_PATH" ]]; then
    if [[ "$L" == "ar" ]]; then
      read -p "$ICON_FOLDER أدخل مسار الحفظ: " SAVE_PATH
    else
      read -p "$ICON_FOLDER Enter save path: " SAVE_PATH
    fi
  fi
  [[ ! -d "$SAVE_PATH" ]] && { echo "$ICON_ERROR مسار غير صالح."; return 1; }
  return 0
}

choose_file_path() {
  local FILE=""
  if command -v zenity &>/dev/null; then
    if [[ "$L" == "ar" ]]; then
      FILE=$(zenity --file-selection --title="اختر ملف التحويل")
    else
      FILE=$(zenity --file-selection --title="Choose file to convert")
    fi
  fi
  if [[ -z "$FILE" ]]; then
    if [[ "$L" == "ar" ]]; then
      read -p "$ICON_FILE أدخل مسار الملف: " FILE
    else
      read -p "$ICON_FILE Enter file path: " FILE
    fi
  fi
  [[ ! -f "$FILE" ]] && { echo "$ICON_ERROR ملف غير صالح."; return 1; }
  echo "$FILE"
  return 0
}

# ----------------------------
# وظائف الواجهة المحسنة
# ----------------------------
choose_quality() {
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_QUALITY اختر جودة الفيديو:"
    echo "  1) عالية الجودة"
    echo "  2) متوسطة الجودة (720p)"
    echo "  3) منخفضة الجودة (480p)"
    echo "  4) تحويل إلى MP4"
  else
    echo "$ICON_QUALITY Select video quality:"
    echo "  1) High quality"
    echo "  2) Medium quality (720p)"
    echo "  3) Low quality (480p)"
    echo "  4) Convert to MP4"
  fi
  read -p "➤ " quality
  case $quality in
    1) FORMAT="bestvideo+bestaudio/best"; EXT_OPT="";;
    2) FORMAT="bv[height<=720]+ba/best[height<=720]"; EXT_OPT="";;
    3) FORMAT="bv[height<=480]+ba/best[height<=480]"; EXT_OPT="";;
    4) FORMAT="bestvideo+bestaudio/best"; EXT_OPT="--recode-video mp4";;
    *) echo "$ICON_ERROR خيار غير صالح."; return 1;;
  esac
  return 0
}

choose_conversion_format() {
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_FORMAT اختر صيغة الإخراج:"
    echo "  1) MP3 (صوت)"
    echo "  2) MP4 (فيديو)"
    echo "  3) WebM (فيديو)"
    echo "  4) MKV (فيديو)"
    echo "  5) WAV (صوت عالي الجودة)"
    echo "  6) FLAC (صوت بدون فقدان)"
  else
    echo "$ICON_FORMAT Choose output format:"
    echo "  1) MP3 (audio)"
    echo "  2) MP4 (video)"
    echo "  3) WebM (video)"
    echo "  4) MKV (video)"
    echo "  5) WAV (high quality audio)"
    echo "  6) FLAC (lossless audio)"
  fi
  read -p "➤ " conv_format
  case $conv_format in
    1) EXT="mp3";;
    2) EXT="mp4";;
    3) EXT="webm";;
    4) EXT="mkv";;
    5) EXT="wav";;
    6) EXT="flac";;
    *) echo "$ICON_ERROR خيار غير صالح."; return 1;;
  esac
  return 0
}

choose_audio_format() {
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_AUDIO اختر صيغة الصوت:"
    echo "  1) MP3 (موصى به)"
    echo "  2) M4A (Apple)"
    echo "  3) Opus (كفاءة عالية)"
    echo "  4) FLAC (بدون فقدان)"
    echo "  5) WAV (جودة عالية)"
  else
    echo "$ICON_AUDIO Choose audio format:"
    echo "  1) MP3 (recommended)"
    echo "  2) M4A (Apple)"
    echo "  3) Opus (high efficiency)"
    echo "  4) FLAC (lossless)"
    echo "  5) WAV (high quality)"
  fi
  read -p "➤ " audio_format
  case $audio_format in
    1) AUDIO_OPTS="--extract-audio --audio-format mp3";;
    2) AUDIO_OPTS="--extract-audio --audio-format m4a";;
    3) AUDIO_OPTS="--extract-audio --audio-format opus";;
    4) AUDIO_OPTS="--extract-audio --audio-format flac";;
    5) AUDIO_OPTS="--extract-audio --audio-format wav";;
    *) AUDIO_OPTS="";;
  esac
}

get_advanced_options() {
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_SETTINGS اختر خيارات متقدمة:"
    echo "  1) تحميل الصورة المصغرة"
    echo "  2) تحميل الترجمة التلقائية"
    echo "  3) تخطي الأخطاء"
    echo "  4) تحميل كصوت"
    echo "  5) لا شيء"
  else
    echo "$ICON_SETTINGS Choose advanced options:"
    echo "  1) Download thumbnail"
    echo "  2) Download subtitles"
    echo "  3) Ignore errors"
    echo "  4) Download as audio"
    echo "  5) None"
  fi
  read -p "➤ " adv_opts
  EXTRA_OPTS=""
  AUDIO_OPTS=""
  IFS=',' read -ra CHOICES <<< "$adv_opts"
  for opt in "${CHOICES[@]}"; do
    case "$opt" in
      1) EXTRA_OPTS+=" --write-thumbnail";;
      2) EXTRA_OPTS+=" --write-auto-sub";;
      3) EXTRA_OPTS+=" --ignore-errors";;
      4) choose_audio_format;;
    esac
  done
}

# ----------------------------
# وظائف التثبيت وإلغاء التثبيت
# ----------------------------
install_desktop_shortcut() {
  local DESKTOP_DIR="$HOME/.local/share/applications"
  local ICON_DIR="$HOME/.local/share/icons"
  local ICON_NAME="gmd-icon.png"
  local ICON_PATH="$ICON_DIR/$ICON_NAME"
  
  mkdir -p "$DESKTOP_DIR" "$ICON_DIR"
  
  echo "$ICON_INSTALL تثبيت اختصار سطح المكتب..."
  
  # تنزيل الأيقونة
  if [[ ! -f "$ICON_PATH" ]]; then
    echo "$ICON_DOWNLOAD تنزيل أيقونة البرنامج..."
    curl -L "https://raw.githubusercontent.com/SalehGNUTUX/GMD/main/GMD%20APPIAMGE%20BIULD/gmd-icon.png" -o "$ICON_PATH" 2>/dev/null || {
      echo "$ICON_INFO استخدام أيقونة افتراضية..."
      ICON_PATH="system-search"
    }
  fi
  
  # إنشاء ملف .desktop
  local DESKTOP_FILE="$DESKTOP_DIR/gmd.desktop"
  cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Name=GMD - GNU Media Downloader
Comment=Download and convert media
Exec=$SELF_PATH
Icon=$ICON_PATH
Terminal=true
Type=Application
Categories=Utility;Network;
EOF
  
  # تحديث قاعدة بيانات التطبيقات
  if command -v update-desktop-database &>/dev/null; then
    update-desktop-database ~/.local/share/applications
  fi
  
  echo "$ICON_SUCCESS تم إنشاء اختصار سطح المكتب في: $DESKTOP_FILE"
  echo "$ICON_INFO يمكنك الآن العثور على التطبيق في قائمة التطبيقات"
}

uninstall_gmd() {
  echo "$ICON_UNINSTALL بدء عملية إلغاء التثبيت..."
  
  # تأكيد الإزالة
  if [[ "$L" == "ar" ]]; then
    read -p "هل أنت متأكد من إلغاء تثبيت GMD؟ [y/N]: " confirm
  else
    read -p "Are you sure you want to uninstall GMD? [y/N]: " confirm
  fi
  
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "$ICON_INFO تم إلغاء العملية."
    return
  fi
  
  # إزالة الملف التنفيذي
  if [[ -f "$SELF_PATH" ]]; then
    rm -f "$SELF_PATH"
    echo "$ICON_SUCCESS تمت إزالة الملف التنفيذي"
  fi
  
  # إزالة yt-dlp
  if [[ -f "$YTDLP" ]]; then
    rm -f "$YTDLP"
    echo "$ICON_SUCCESS تمت إزالة yt-dlp"
  fi
  
  # إزالة ملف .desktop
  if [[ -f "$HOME/.local/share/applications/gmd.desktop" ]]; then
    rm -f "$HOME/.local/share/applications/gmd.desktop"
    echo "$ICON_SUCCESS تمت إزالة اختصار سطح المكتب"
  fi
  
  # إزالة الأيقونة
  if [[ -f "$HOME/.local/share/icons/gmd-icon.png" ]]; then
    rm -f "$HOME/.local/share/icons/gmd-icon.png"
    echo "$ICON_SUCCESS تمت إزالة الأيقونة"
  fi
  
  # إزالة مجلد الإعدادات
  if [[ -d "$HOME/.GMD" ]]; then
    rm -rf "$HOME/.GMD"
    echo "$ICON_SUCCESS تمت إزالة مجلد الإعدادات"
  fi
  
  # تحديث كاش التطبيقات
  if command -v update-desktop-database &>/dev/null; then
    update-desktop-database ~/.local/share/applications
  fi
  
  echo "$ICON_SUCCESS تم إلغاء تثبيت GMD بنجاح!"
  exit 0
}

# ----------------------------
# الوظائف الرئيسية
# ----------------------------
download_video() {
  if [[ "$L" == "ar" ]]; then
    read -p "$ICON_URL أدخل رابط الفيديو: " URL
  else
    read -p "$ICON_URL Enter video URL: " URL
  fi
  choose_save_path || return 1
  choose_quality || return 1
  get_advanced_options
  "$YTDLP" $EXTRA_OPTS $AUDIO_OPTS $EXT_OPT -f "$FORMAT" -o "$SAVE_PATH/%(title)s.%(ext)s" "$URL"
  echo "$ICON_SUCCESS تم التحميل بنجاح."
  [[ -n "$FILE_MANAGER" ]] && $FILE_MANAGER "$SAVE_PATH"
}

convert_media() {
  local FILE
  FILE=$(choose_file_path) || return 1
  choose_save_path || return 1
  choose_conversion_format || return 1
  BASENAME=$(basename "$FILE")
  NAME="${BASENAME%.*}"
  ffmpeg -i "$FILE" "$SAVE_PATH/${NAME}.${EXT}"
  echo "$ICON_SUCCESS تم التحويل بنجاح."
  [[ -n "$FILE_MANAGER" ]] && $FILE_MANAGER "$SAVE_PATH"
}

# ----------------------------
# القائمة الرئيسية المحسنة
# ----------------------------
show_main_menu() {
  echo ""
  echo "========================================"
  if [[ "$L" == "ar" ]]; then
    echo "$ICON_VIDEO القائمة الرئيسية - GMD"
    echo "========================================"
    echo "$ICON_DOWNLOAD  1) تحميل فيديو"
    echo "$ICON_CONVERT  2) تحويل ملف وسائط"
    echo "$ICON_INSTALL  3) تثبيت اختصار سطح المكتب"
    echo "$ICON_UNINSTALL  4) إلغاء التثبيت"
    echo "$ICON_EXIT  5) خروج"
    echo "========================================"
    read -p "اختر خيارًا [1-5]: " option
  else
    echo "$ICON_VIDEO Main Menu - GMD"
    echo "========================================"
    echo "$ICON_DOWNLOAD  1) Download Video"
    echo "$ICON_CONVERT  2) Convert Media File"
    echo "$ICON_INSTALL  3) Install Desktop Shortcut"
    echo "$ICON_UNINSTALL  4) Uninstall"
    echo "$ICON_EXIT  5) Exit"
    echo "========================================"
    read -p "Choose an option [1-5]: " option
  fi
}

# ----------------------------
# التنفيذ الرئيسي
# ----------------------------
install_yt_dlp
update_yt_dlp
self_update "$@"

while true; do
  show_main_menu
  case $option in
    1) download_video;;
    2) convert_media;;
    3) install_desktop_shortcut;;
    4) uninstall_gmd;;
    5) 
      if [[ "$L" == "ar" ]]; then
        echo "$ICON_EXIT مع السلامة!"
      else
        echo "$ICON_EXIT Goodbye!"
      fi
      exit 0;;
    *) 
      if [[ "$L" == "ar" ]]; then
        echo "$ICON_ERROR خيار غير صالح. الرجاء المحاولة مرة أخرى."
      else
        echo "$ICON_ERROR Invalid option. Please try again."
      fi;;
  esac
  echo ""
  if [[ "$L" == "ar" ]]; then
    read -p "اضغط Enter للمتابعة..." dummy
  else
    read -p "Press Enter to continue..." dummy
  fi
  clear
  # إعادة عرض الشعار بعد كل عملية
  echo "
   ____   __  __   ____
  / ___| |  \/  | |  _ \\
 | |  _  | |\/| | | | | |
 | |_| | | |  | | | |_| |
  \\____| |_|  |_| |____/
-------------------------
   GNU MEDIA DOWNLOADER
-------------------------
       » BY GNUTUX «
         » v1.5 «
"
done
