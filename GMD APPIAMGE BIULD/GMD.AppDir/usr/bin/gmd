#!/bin/bash
set -euo pipefail

INSTALL_DIR="$HOME/.local/bin"
YTDLP_PATH="$INSTALL_DIR/yt-dlp"

# دالة لتحميل yt-dlp من المصدر
install_yt_dlp() {
    echo "🔍 Checking for yt-dlp..."

    if [ -x "$YTDLP_PATH" ]; then
        echo "✅ yt-dlp already installed in $YTDLP_PATH"
    else
        echo "⬇️ Installing yt-dlp from GitHub..."
        mkdir -p "$INSTALL_DIR"

        if command -v aria2c &>/dev/null; then
            aria2c "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" \
              --dir "$INSTALL_DIR" -o yt-dlp
        elif command -v curl &>/dev/null; then
            curl -L "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" \
              -o "$YTDLP_PATH"
        elif command -v wget &>/dev/null; then
            wget "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" \
              -O "$YTDLP_PATH"
        else
            echo "❌ No download tool found (need aria2c, curl or wget)."
            exit 1
        fi

        chmod a+rx "$YTDLP_PATH"
        echo "✅ yt-dlp installed successfully."
    fi

    # تأكد من أن المسار مضاف
    if ! echo "$PATH" | grep -q "$INSTALL_DIR"; then
        echo "⚠️  $INSTALL_DIR not in PATH. Please add it to your shell config."
    fi
}

# دالة لتحديث yt-dlp
update_yt_dlp() {
    if command -v yt-dlp &>/dev/null; then
        echo "🔄 Updating yt-dlp..."
        yt-dlp -U || echo "⚠️ Failed to update yt-dlp, using current version."
    fi
}

# تثبيت/تحديث yt-dlp
install_yt_dlp
update_yt_dlp

# 🚀 هنا يبدأ تشغيل GMD
echo "🎬 Launching GMD..."
# exec /usr/bin/gmd-main "$@"   # ← ضع هنا مسار سكربت GMD الرئيسي
