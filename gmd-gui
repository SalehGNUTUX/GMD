#!/bin/bash
# GMD-GUI - GNU Media Downloader (Graphical Edition) v1.92
# by gnutux
# نسخة رسومية كاملة تعتمد على zenity

set -uo pipefail

# ----------------------------
# المسارات والإعدادات الأساسية
# ----------------------------
BIN_DIR="$HOME/.local/bin"
mkdir -p "$BIN_DIR"
SELF_PATH="$BIN_DIR/gmd-gui"
YTDLP="$BIN_DIR/yt-dlp"
UPDATE_MARKER="$HOME/.config/gmd_last_update"
DESKTOP_MARKER="$HOME/.config/gmd_desktop_installed"
REPO_RAW_URL="https://raw.githubusercontent.com/SalehGNUTUX/GMD/main/gmd-gui"
LOG_FILE="$HOME/.config/gmd_gui.log"
mkdir -p "$(dirname "$UPDATE_MARKER")"

# ----------------------------
# اللغة الافتراضية
# ----------------------------
LANGUAGE="${GMD_LANG:-ar}"

# ----------------------------
# التحقق من zenity أولاً
# ----------------------------
if ! command -v zenity &>/dev/null; then
    echo "❌ zenity غير مثبت. يرجى تثبيته أولاً:"
    echo "   sudo apt install zenity   # Ubuntu/Debian"
    echo "   sudo dnf install zenity   # Fedora"
    echo "   sudo pacman -S zenity     # Arch"
    exit 1
fi

# ----------------------------
# دوال النصوص الثنائية اللغة
# ----------------------------
t() {
    local ar="$1"
    local en="$2"
    if [[ "$LANGUAGE" == "ar" ]]; then
        echo "$ar"
    else
        echo "$en"
    fi
}

# ----------------------------
# الشعار والعنوان
# ----------------------------
APP_TITLE="$(t 'GMD — منزل وسائط جنو' 'GMD — GNU Media Downloader')"
APP_VER="v1.92"
WIN_ICON=""
# محاولة استخدام الأيقونة إن وجدت
ICON_PATH="$HOME/.local/share/icons/hicolor/48x48/apps/gmd-icon.png"
[[ -f "$ICON_PATH" ]] && WIN_ICON="--window-icon=$ICON_PATH"

# دالة zenity مشتركة تضيف العنوان والأيقونة تلقائياً
zrun() {
    zenity $WIN_ICON --title="$APP_TITLE $APP_VER" "$@" 2>/dev/null
}

# ----------------------------
# رسائل الخطأ والنجاح
# ----------------------------
msg_info() {
    zrun --info --text="$1" --ok-label="$(t 'حسناً' 'OK')" &
}

msg_error() {
    zrun --error --text="$1" --ok-label="$(t 'حسناً' 'OK')"
}

msg_ok() {
    zrun --info --text="✅  $1" --ok-label="$(t 'حسناً' 'OK')"
}

msg_confirm() {
    zrun --question \
         --text="$1" \
         --ok-label="$(t 'نعم' 'Yes')" \
         --cancel-label="$(t 'إلغاء' 'Cancel')"
}

# ----------------------------
# شريط تقدم يعرض مخرجات yt-dlp الحقيقية سطراً بسطر
# ----------------------------
run_with_progress() {
    local TITLE="$1"
    local TEXT="$2"
    local CMD="$3"
    local LOG="$LOG_FILE"
    local PIPE
    PIPE=$(mktemp -u /tmp/gmd_pipe_XXXXXX)
    mkfifo "$PIPE"

    # تنفيذ الأمر مع إرسال مخرجاته للـ pipe
    (
        eval "$CMD" 2>&1 | tee "$LOG" | while IFS= read -r LINE; do
            # تنظيف السطر من رموز ANSI وإرساله لـ zenity
            CLEAN=$(echo "$LINE" | sed 's/\x1B\[[0-9;]*[mK]//g' | tr -d '\r')
            # إذا كان سطر تقدم yt-dlp (يحتوي على %)
            if echo "$CLEAN" | grep -q '%'; then
                PCT=$(echo "$CLEAN" | grep -oP '\d+\.\d+(?=%)' | tail -1 | cut -d. -f1)
                [[ -n "$PCT" && "$PCT" -le 100 ]] && echo "$PCT"
            fi
            # إرسال النص كتعليق يظهر في نافذة التقدم
            echo "# $CLEAN"
        done
        echo "100"
    ) > "$PIPE" &
    local BG_PID=$!

    # عرض شريط التقدم مع القراءة من الـ pipe
    zenity $WIN_ICON \
        --progress \
        --title="$TITLE" \
        --text="$TEXT" \
        --width=520 \
        --auto-close \
        --no-cancel \
        --ok-label="$(t 'حسناً' 'OK')" \
        < "$PIPE" 2>/dev/null

    wait "$BG_PID" 2>/dev/null
    rm -f "$PIPE"

    # كود الخروج الحقيقي من السجل (0 إذا اكتمل بنجاح)
    grep -qiE "error|ERROR|فشل|failed" "$LOG" 2>/dev/null && return 1
    return 0
}

# ----------------------------
# عرض نتيجة التنزيل
# ----------------------------
show_result() {
    local SUCCESS="$1"
    local LOG="$LOG_FILE"
    local OUTPUT_TEXT

    if [[ "$SUCCESS" == "0" ]]; then
        OUTPUT_TEXT="✅ $(t 'اكتملت العملية بنجاح!' 'Operation completed successfully!')\n\n$(t 'السجل:' 'Log:') $(tail -5 "$LOG" 2>/dev/null | tr '\n' ' ')"
        zrun --info \
             --text="$OUTPUT_TEXT" \
             --ok-label="$(t 'ممتاز!' 'Great!')" \
             --width=500
    else
        OUTPUT_TEXT="❌ $(t 'فشلت العملية.' 'Operation failed.')\n\n$(t 'تفاصيل الخطأ:' 'Error details:') $(tail -10 "$LOG" 2>/dev/null | tr '\n' '\n')"
        zrun --error \
             --text="$OUTPUT_TEXT" \
             --ok-label="$(t 'حسناً' 'OK')" \
             --width=500
    fi
}

# ----------------------------
# اختيار مجلد الحفظ
# ----------------------------
choose_save_path() {
    local SAVE_PATH
    SAVE_PATH=$(zrun --file-selection \
                     --directory \
                     --filename="$HOME/Downloads/" \
                     --text="$(t 'اختر مجلد الحفظ' 'Choose save folder')" 2>/dev/null)
    if [[ -z "$SAVE_PATH" ]]; then
        SAVE_PATH="$HOME/Downloads"
    fi
    echo "$SAVE_PATH"
}

# ----------------------------
# إدخال الرابط
# ----------------------------
get_url() {
    local URL
    URL=$(zrun --entry \
               --text="$(t '🌐 أدخل رابط الفيديو أو الصوت:' '🌐 Enter video or audio URL:')" \
               --entry-text="" \
               2>/dev/null)
    if [[ -z "$URL" ]]; then
        return 1
    fi
    echo "$URL"
}

# ----------------------------
# اختيار ملف محلي
# ----------------------------
choose_local_file() {
    local FILE
    FILE=$(zrun --file-selection \
                --filename="$HOME/" \
                --text="$(t 'اختر الملف' 'Choose file')" \
                --file-filter="$(t 'ملفات الوسائط' 'Media files') | *.mp4 *.mp3 *.mkv *.avi *.mov *.webm *.m4a *.flac *.wav *.ogg *.opus" \
                2>/dev/null)
    [[ -z "$FILE" ]] && return 1
    echo "$FILE"
}

# ----------------------------
# قائمة جودة الفيديو
# ----------------------------
# الجودةُ سقفٌ على الضلعِ الأصغرِ لا على الارتفاع: مقطعُ «720p» عموديّاً مقاسُه
# 720×1280، فترشيحُ `height<=720` لا يُطابِقُ منه شيئاً ويموتُ التنزيلُ بـ
# «Requested format is not available». وحقلُ `res` في `-S` هو الضلعُ الأصغرُ نفسُه
# فيَصحُّ في الاتّجاهَين، وهو ترتيبٌ لا شرطٌ قاطعٌ فلا يفشلُ إن عُدِمَ ما تحتَ السقف.
CAPPED_FORMAT="bv*[height>0]+ba/b[height>0]/bv*+ba/b"

choose_video_quality() {
    local CHOICE
    CHOICE=$(zrun --list \
                  --radiolist \
                  --text="$(t '🎞️ اختر جودة الفيديو:' '🎞️ Choose video quality:')" \
                  --column="" \
                  --column="$(t 'الجودة' 'Quality')" \
                  --column="$(t 'الوصف' 'Description')" \
                  --width=450 --height=300 \
                  TRUE  "1080p" "$(t 'عالية' 'High')" \
                  FALSE "720p"  "$(t 'متوسطة' 'Medium')" \
                  FALSE "480p"  "$(t 'منخفضة' 'Low')" \
                  FALSE "$(t 'أفضل متاحة' 'Best available')" "$(t 'أعلى جودة ممكنة' 'Highest possible')" \
                  2>/dev/null)
    [[ -z "$CHOICE" ]] && return 1

    # تُعادُ الصيغةُ والترتيبُ مفصولَين بـ«|»، لأنّ الدالّةَ تُنادى داخلَ $( ) فأيُّ
    # إسنادٍ لمتغيّرٍ عامٍّ فيها يضيعُ في الصدفةِ الفرعيّة.
    case "$CHOICE" in
        "1080p")  echo "$CAPPED_FORMAT|-S res:1080" ;;
        "720p")   echo "$CAPPED_FORMAT|-S res:720" ;;
        "480p")   echo "$CAPPED_FORMAT|-S res:480" ;;
        *)         echo "bv*+ba/b|" ;;
    esac
}

# ----------------------------
# قائمة صيغة الصوت
# ----------------------------
choose_audio_format() {
    local CHOICE
    CHOICE=$(zrun --list \
                  --radiolist \
                  --text="$(t '🎵 اختر صيغة الصوت:' '🎵 Choose audio format:')" \
                  --column="" \
                  --column="$(t 'الصيغة' 'Format')" \
                  --column="$(t 'الوصف' 'Description')" \
                  --width=450 --height=330 \
                  TRUE  "mp3"  "$(t 'جودة متوسطة - الأكثر توافقاً' 'Medium quality - most compatible')" \
                  FALSE "m4a"  "$(t 'جيدة للأجهزة المحمولة' 'Good for mobile devices')" \
                  FALSE "ogg"  "$(t 'حجم صغير - مفتوح المصدر' 'Small size - open source')" \
                  FALSE "opus" "$(t 'كفاءة عالية - جودة ممتازة' 'High efficiency - excellent quality')" \
                  FALSE "flac" "$(t 'بدون خسارة - جودة أصلية' 'Lossless - original quality')" \
                  FALSE "wav"  "$(t 'جودة أصلية - حجم كبير' 'Original quality - large size')" \
                  2>/dev/null)
    [[ -z "$CHOICE" ]] && return 1

    case "$CHOICE" in
        mp3)  echo "--extract-audio --audio-format mp3 --audio-quality 0" ;;
        m4a)  echo "--extract-audio --audio-format m4a" ;;
        ogg)  echo "--extract-audio --audio-format vorbis" ;;
        opus) echo "--extract-audio --audio-format opus" ;;
        flac) echo "--extract-audio --audio-format flac" ;;
        wav)  echo "--extract-audio --audio-format wav" ;;
    esac
}

# ----------------------------
# قائمة صيغة التحويل
# ----------------------------
choose_conversion_format() {
    local CHOICE
    CHOICE=$(zrun --list \
                  --radiolist \
                  --text="$(t '🔄 اختر صيغة الإخراج:' '🔄 Choose output format:')" \
                  --column="" \
                  --column="$(t 'الصيغة' 'Format')" \
                  --column="$(t 'النوع' 'Type')" \
                  --width=430 --height=380 \
                  TRUE  "mp3"  "$(t 'صوت' 'Audio')" \
                  FALSE "m4a"  "$(t 'صوت' 'Audio')" \
                  FALSE "ogg"  "$(t 'صوت' 'Audio')" \
                  FALSE "wav"  "$(t 'صوت' 'Audio')" \
                  FALSE "flac" "$(t 'صوت - بدون خسارة' 'Audio - lossless')" \
                  FALSE "mp4"  "$(t 'فيديو' 'Video')" \
                  FALSE "webm" "$(t 'فيديو - مفتوح المصدر' 'Video - open source')" \
                  2>/dev/null)
    [[ -z "$CHOICE" ]] && return 1

    case "$CHOICE" in
        mp3)  EXT="mp3";  CONV_OPTS="-c:a libmp3lame -b:a 192k" ;;
        m4a)  EXT="m4a";  CONV_OPTS="-c:a aac -b:a 192k" ;;
        ogg)  EXT="ogg";  CONV_OPTS="-c:a libvorbis -q:a 4" ;;
        wav)  EXT="wav";  CONV_OPTS="" ;;
        flac) EXT="flac"; CONV_OPTS="-c:a flac" ;;
        mp4)  EXT="mp4";  CONV_OPTS="-c:v libx264 -crf 23 -c:a aac -b:a 192k" ;;
        webm) EXT="webm"; CONV_OPTS="-c:v libvpx-vp9 -crf 30 -b:v 0 -c:a libopus" ;;
    esac
    return 0
}

# ----------------------------
# فتح مجلد الحفظ بعد التنزيل
# ----------------------------
open_folder() {
    local DIR="$1"
    if command -v xdg-open &>/dev/null; then
        xdg-open "$DIR" 2>/dev/null &
    fi
}

# ==============================================================
# ==================== وظائف البرنامج الرئيسية ================
# ==============================================================

# ----------------------------
# 1. تنزيل فيديو
# ----------------------------
do_download_video() {
    local URL FORMAT SAVE_PATH

    URL=$(get_url) || return 0

    local QSEL SORT_OPT
    QSEL=$(choose_video_quality) || return 0
    FORMAT="${QSEL%%|*}"; SORT_OPT="${QSEL#*|}"

    SAVE_PATH=$(choose_save_path)

    run_with_progress \
        "$(t 'تنزيل فيديو' 'Download Video')" \
        "$(t '⬇️ جاري تنزيل الفيديو...' '⬇️ Downloading video...')" \
        "\"$YTDLP\" -f \"$FORMAT\" $SORT_OPT -o \"$SAVE_PATH/%(title)s.%(ext)s\" \"$URL\""

    local STATUS=$?
    show_result "$STATUS"
    [[ "$STATUS" == "0" ]] && open_folder "$SAVE_PATH"
}

# ----------------------------
# 2. تنزيل صوت
# ----------------------------
do_download_audio() {
    local URL AUDIO_OPTS SAVE_PATH

    URL=$(get_url) || return 0

    AUDIO_OPTS=$(choose_audio_format) || return 0

    SAVE_PATH=$(choose_save_path)

    run_with_progress \
        "$(t 'تنزيل صوت' 'Download Audio')" \
        "$(t '🎵 جاري تنزيل الصوت...' '🎵 Downloading audio...')" \
        "\"$YTDLP\" $AUDIO_OPTS -o \"$SAVE_PATH/%(title)s.%(ext)s\" \"$URL\""

    local STATUS=$?
    show_result "$STATUS"
    [[ "$STATUS" == "0" ]] && open_folder "$SAVE_PATH"
}

# ----------------------------
# 3. تنزيل وتحويل مباشر
# ----------------------------
do_download_convert() {
    local URL SAVE_PATH EXT CONV_OPTS

    URL=$(get_url) || return 0

    choose_conversion_format || return 0

    SAVE_PATH=$(choose_save_path)

    # تحديد الأمر حسب النوع
    local CMD
    if [[ "$EXT" == "mp4" || "$EXT" == "webm" ]]; then
        local FORMAT QSEL SORT_OPT
        QSEL=$(choose_video_quality) || return 0
        FORMAT="${QSEL%%|*}"; SORT_OPT="${QSEL#*|}"
        CMD="\"$YTDLP\" -f \"$FORMAT\" $SORT_OPT --merge-output-format $EXT -o \"$SAVE_PATH/%(title)s.%(ext)s\" \"$URL\""
    else
        CMD="\"$YTDLP\" --extract-audio --audio-format $EXT --audio-quality 0 -o \"$SAVE_PATH/%(title)s.%(ext)s\" \"$URL\""
    fi

    run_with_progress \
        "$(t 'تنزيل وتحويل' 'Download & Convert')" \
        "$(t '🧠 جاري التنزيل والتحويل الذكي...' '🧠 Smart downloading and converting...')" \
        "$CMD"

    local STATUS=$?
    show_result "$STATUS"
    [[ "$STATUS" == "0" ]] && open_folder "$SAVE_PATH"
}

# ----------------------------
# 4. تحويل ملف موجود
# ----------------------------
do_convert_media() {
    local FILE SAVE_PATH EXT CONV_OPTS

    FILE=$(choose_local_file) || return 0

    choose_conversion_format || return 0

    SAVE_PATH=$(choose_save_path)

    local BASENAME NAME OUTPUT_FILE
    BASENAME=$(basename "$FILE")
    NAME="${BASENAME%.*}"
    OUTPUT_FILE="$SAVE_PATH/${NAME}.${EXT}"

    run_with_progress \
        "$(t 'تحويل وسائط' 'Convert Media')" \
        "$(t '🔄 جاري التحويل...' '🔄 Converting...')" \
        "ffmpeg -i \"$FILE\" $CONV_OPTS \"$OUTPUT_FILE\" -y"

    local STATUS=$?
    if [[ "$STATUS" == "0" && -f "$OUTPUT_FILE" ]]; then
        local SIZE
        SIZE=$(du -h "$OUTPUT_FILE" 2>/dev/null | cut -f1)
        zrun --info \
             --text="✅ $(t 'تم التحويل بنجاح!' 'Converted successfully!')\n\n📄 $(t 'الملف:' 'File:') $OUTPUT_FILE\n📊 $(t 'الحجم:' 'Size:') $SIZE" \
             --ok-label="$(t 'فتح المجلد' 'Open Folder')" \
             --extra-button="$(t 'إغلاق' 'Close')" \
             --width=500 2>/dev/null && open_folder "$SAVE_PATH"
    else
        show_result "1"
    fi
}

# do_extra_options defined later with stable IDs

# ----------------------------
# 6. قص الفيديو/الصوت
# ----------------------------
do_clip_media() {
    local CLIP_TYPE
    CLIP_TYPE=$(zrun --list \
                     --text="$(t '✂️ اختر نوع القص:' '✂️ Choose trim type:')" \
                     --column="$(t 'النوع' 'Type')" \
                     --column="$(t 'الوصف' 'Description')" \
                     --width=460 --height=220 \
                     "$(t '🌐 من رابط' 'From URL')"        "$(t 'قص مقطع مباشرة من الإنترنت' 'Trim clip directly from URL')" \
                     "$(t '📁 ملف محلي' 'Local file')"    "$(t 'قص ملف موجود على جهازك' 'Trim an existing file')" \
                     2>/dev/null)
    [[ -z "$CLIP_TYPE" ]] && return 0

    # نموذج إدخال أوقات القص
    local TIMES
    TIMES=$(zrun --forms \
                 --text="$(t '✂️ أدخل أوقات القص\nمثال: 00:01:30' '✂️ Enter trim times\nExample: 00:01:30')" \
                 --add-entry="$(t 'وقت البداية' 'Start time')" \
                 --add-entry="$(t 'وقت النهاية' 'End time')" \
                 --ok-label="$(t 'قص' 'Trim')" \
                 --cancel-label="$(t 'إلغاء' 'Cancel')" \
                 --width=380 \
                 2>/dev/null)
    [[ -z "$TIMES" ]] && return 0

    local START_TIME END_TIME
    START_TIME=$(echo "$TIMES" | cut -d'|' -f1)
    END_TIME=$(echo "$TIMES" | cut -d'|' -f2)

    if [[ -z "$START_TIME" || -z "$END_TIME" ]]; then
        msg_error "$(t 'يرجى إدخال وقت البداية والنهاية.' 'Please enter both start and end times.')"
        return 0
    fi

    local SAVE_PATH
    SAVE_PATH=$(choose_save_path)

    local CMD TITLE TEXT

    if [[ "$CLIP_TYPE" == *"$(t 'من رابط' 'From URL')"* ]]; then
        local URL
        URL=$(get_url) || return 0
        TITLE="$(t 'قص من رابط' 'Trim from URL')"
        TEXT="$(t '✂️ جاري القص والتنزيل...' '✂️ Trimming and downloading...')"
        CMD="\"$YTDLP\" --download-sections \"*${START_TIME}-${END_TIME}\" --force-keyframes-at-cuts -o \"$SAVE_PATH/%(title)s_clip.%(ext)s\" \"$URL\""
    else
        local FILE
        FILE=$(choose_local_file) || return 0
        local BNAME EXT_F OUT
        BNAME=$(basename "$FILE")
        EXT_F="${BNAME##*.}"
        OUT="$SAVE_PATH/${BNAME%.*}_clip.$EXT_F"
        TITLE="$(t 'قص ملف' 'Trim File')"
        TEXT="$(t '✂️ جاري القص...' '✂️ Trimming...')"
        CMD="ffmpeg -ss \"$START_TIME\" -to \"$END_TIME\" -i \"$FILE\" -c copy \"$OUT\" -y"
    fi

    run_with_progress "$TITLE" "$TEXT" "$CMD"
    local STATUS=$?
    show_result "$STATUS"
    [[ "$STATUS" == "0" ]] && open_folder "$SAVE_PATH"
}

# ----------------------------
# 7. معلومات الوسائط
# ----------------------------
do_media_info() {
    local URL
    URL=$(get_url) || return 0

    # شريط تقدم أثناء الجلب
    local INFO
    (
        echo "10"; sleep 0.5
        echo "# $(t 'جاري الاتصال بالخادم...' 'Connecting to server...')"
        INFO=$("$YTDLP" --dump-json "$URL" 2>/dev/null)
        echo "100"
    ) | zrun --progress \
             --text="$(t '📋 جاري جلب معلومات الوسائط...' '📋 Fetching media info...')" \
             --pulsate --auto-close --no-cancel 2>/dev/null

    INFO=$("$YTDLP" --dump-json "$URL" 2>/dev/null)

    if [[ -z "$INFO" ]]; then
        msg_error "$(t 'تعذر جلب معلومات الوسائط.\nتحقق من الرابط والاتصال بالإنترنت.' 'Could not fetch media info.\nCheck the URL and internet connection.')"
        return 0
    fi

    # استخراج المعلومات
    local TITLE UPLOADER DURATION RESOLUTION EXT VIEWS WEBPAGE
    TITLE=$(echo "$INFO" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('title','—'))" 2>/dev/null || echo "—")
    UPLOADER=$(echo "$INFO" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('uploader','—'))" 2>/dev/null || echo "—")
    DURATION=$(echo "$INFO" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('duration_string') or str(d.get('duration','—')))" 2>/dev/null || echo "—")
    RESOLUTION=$(echo "$INFO" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('resolution','—'))" 2>/dev/null || echo "—")
    EXT=$(echo "$INFO" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('ext','—'))" 2>/dev/null || echo "—")
    VIEWS=$(echo "$INFO" | python3 -c "import json,sys; d=json.load(sys.stdin); v=d.get('view_count'); print(f'{v:,}' if v else '—')" 2>/dev/null || echo "—")
    WEBPAGE=$(echo "$INFO" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('webpage_url','—'))" 2>/dev/null || echo "—")

    local INFO_TEXT
    INFO_TEXT="📋 $(t 'معلومات الوسائط' 'Media Information')\n"
    INFO_TEXT+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    INFO_TEXT+="🎬 $(t 'العنوان:' 'Title:')       $TITLE\n"
    INFO_TEXT+="👤 $(t 'المحمّل:' 'Uploader:')    $UPLOADER\n"
    INFO_TEXT+="⏱️  $(t 'المدة:' 'Duration:')     $DURATION\n"
    INFO_TEXT+="📐 $(t 'الجودة:' 'Resolution:')   $RESOLUTION\n"
    INFO_TEXT+="🎞️  $(t 'الصيغة:' 'Format:')      $EXT\n"
    INFO_TEXT+="👁️  $(t 'المشاهدات:' 'Views:')    $VIEWS\n"
    INFO_TEXT+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    INFO_TEXT+="🌐 $WEBPAGE"

    zrun --info \
         --text="$INFO_TEXT" \
