    # إذا أغلق المستخدم النافذة أو ضغط خروج
    if [[ -z "$CHOICE" ]]; then
        msg_confirm "$(t '🚪 هل تريد الخروج من GMD-GUI؟' '🚪 Do you want to exit GMD-GUI?')" \
            && exit 0
        continue
    fi

    case "$CHOICE" in
        VID)      do_download_video ;;
        AUD)      do_download_audio ;;
        SMART)    do_download_convert ;;
        CONV)     do_convert_media ;;
        EXTRA)    do_extra_options ;;
        CLIP)     do_clip_media ;;
        INFO)     do_media_info ;;
        SETTINGS) do_settings ;;
        *)
