# ----------------------------
# قائمة الإعدادات - بنفس مبدأ المعرّفات الثابتة
# ----------------------------
do_settings() {
    local CHOICE
    CHOICE=$(zenity $WIN_ICON \
                  --list \
                  --title="$APP_TITLE $APP_VER" \
                  --text="$(t '⚙️ الإعدادات' '⚙️ Settings')" \
                  --column="ID" \
                  --column="$(t 'الخيار' 'Option')" \
                  --column="$(t 'الوصف' 'Description')" \
                  --hide-column=1 \
                  --width=540 --height=360 \
                  --ok-label="$(t 'تنفيذ' 'Run')" \
                  --cancel-label="$(t '🔙 رجوع' '🔙 Back')" \
                  "LANG"      "$(t '🌐 تغيير اللغة'              'Change Language')"         "$(t 'التبديل بين العربية والإنجليزية'          'Switch between Arabic and English')" \
                  "YTDLP"     "$(t '🔄 تحديث yt-dlp'            'Update yt-dlp')"           "$(t 'تحديث أداة التنزيل للنسخة الأحدث'         'Update download engine to latest')" \
                  "UPDATE"    "$(t '⬆️ تحديث GMD-GUI'           'Update GMD-GUI')"          "$(t 'تحديث البرنامج من المستودع'               'Update program from repository')" \
                  "DESKTOP"   "$(t '🖥️ إصلاح أيقونة سطح المكتب' 'Fix Desktop Icon')"       "$(t 'إعادة تثبيت الأيقونة في قائمة التطبيقات'  'Reinstall icon in app menu')" \
                  "UNINSTALL" "$(t '🗑️ إلغاء التثبيت الكامل'    'Complete Uninstall')"      "$(t 'إزالة البرنامج وجميع ملفاته نهائياً'       'Remove program and all its files')" \
                  2>/dev/null)

    [[ -z "$CHOICE" ]] && return 0

    case "$CHOICE" in
        LANG)
            if [[ "$LANGUAGE" == "ar" ]]; then
                LANGUAGE="en"
                # تحديث عنوان التطبيق بعد تغيير اللغة
                APP_TITLE="$(t 'GMD — منزل وسائط جنو' 'GMD — GNU Media Downloader')"
                msg_ok "Language switched to English. ✅"
            else
                LANGUAGE="ar"
                APP_TITLE="$(t 'GMD — منزل وسائط جنو' 'GMD — GNU Media Downloader')"
                msg_ok "تم التبديل إلى العربية. ✅"
            fi
            ;;
        YTDLP)
            run_with_progress \
                "$(t 'تحديث yt-dlp' 'Update yt-dlp')" \
                "$(t '🔄 جاري تحديث yt-dlp...' '🔄 Updating yt-dlp...')" \
                "\"$YTDLP\" -U"
            show_result "$?"
            ;;
        UPDATE)   update_gmd_gui ;;
        DESKTOP)
            install_desktop_shortcut
            msg_ok "$(t 'تم إصلاح اختصار سطح المكتب بنجاح!' 'Desktop shortcut fixed successfully!')"
            ;;
        UNINSTALL) uninstall_gmd_gui ;;
    esac
}

# ----------------------------
# قائمة الخيارات الإضافية - بمعرّفات ثابتة
# ----------------------------
do_extra_options() {
    local CHOICE
    CHOICE=$(zenity $WIN_ICON \
                  --list \
                  --title="$APP_TITLE $APP_VER" \
                  --text="$(t '⚡ خيارات التنزيل الإضافية' '⚡ Extra Download Options')" \
                  --column="ID" \
                  --column="$(t 'الخيار' 'Option')" \
                  --column="$(t 'الوصف' 'Description')" \
                  --hide-column=1 \
                  --width=540 --height=330 \
                  --ok-label="$(t 'تنفيذ' 'Run')" \
                  --cancel-label="$(t '🔙 رجوع' '🔙 Back')" \
                  "PLAYLIST"  "$(t '📋 قائمة تشغيل'   'Playlist')"       "$(t 'تنزيل قائمة تشغيل كاملة'             'Download complete playlist')" \
                  "CHANNEL"   "$(t '📺 قناة'           'Channel')"        "$(t 'تنزيل مقاطع من قناة'                'Download videos from channel')" \
                  "SUBS"      "$(t '💬 ترجمات'         'Subtitles')"      "$(t 'تنزيل الترجمات فقط'                 'Download subtitles only')" \
                  "THUMBS"    "$(t '🖼️ صور مصغرة'     'Thumbnails')"     "$(t 'تنزيل الصور المصغرة فقط'            'Download thumbnails only')" \
                  "COMPLETE"  "$(t '📦 تنزيل شامل'    'Complete package')" "$(t 'فيديو + صوت + ترجمة + صورة مصغرة'  'Video + audio + subtitles + thumbnail')" \
                  2>/dev/null)

    [[ -z "$CHOICE" ]] && return 0

    local URL SAVE_PATH CMD TITLE TEXT

    URL=$(get_url) || return 0
    SAVE_PATH=$(choose_save_path)

    case "$CHOICE" in
        PLAYLIST)
            TITLE="$(t 'تنزيل قائمة التشغيل' 'Download Playlist')"
            TEXT="$(t '📋 جاري تنزيل قائمة التشغيل...' '📋 Downloading playlist...')"
            CMD="\"$YTDLP\" -o \"$SAVE_PATH/%(playlist_title)s/%(title)s.%(ext)s\" \"$URL\""
            ;;
        CHANNEL)
            TITLE="$(t 'تنزيل القناة' 'Download Channel')"
            TEXT="$(t '📺 جاري تنزيل مقاطع القناة...' '📺 Downloading channel videos...')"
            CMD="\"$YTDLP\" -o \"$SAVE_PATH/%(uploader)s/%(title)s.%(ext)s\" \"$URL\""
            ;;
        SUBS)
            TITLE="$(t 'تنزيل الترجمات' 'Download Subtitles')"
            TEXT="$(t '💬 جاري تنزيل الترجمات...' '💬 Downloading subtitles...')"
            CMD="\"$YTDLP\" --write-auto-sub --skip-download -o \"$SAVE_PATH/%(title)s\" \"$URL\""
            ;;
        THUMBS)
            TITLE="$(t 'تنزيل الصور المصغرة' 'Download Thumbnails')"
            TEXT="$(t '🖼️ جاري تنزيل الصور المصغرة...' '🖼️ Downloading thumbnails...')"
            CMD="\"$YTDLP\" --write-thumbnail --skip-download -o \"$SAVE_PATH/%(title)s\" \"$URL\""
            ;;
        COMPLETE)
            local COMPLETE_DIR="$SAVE_PATH/complete_$(date +%Y%m%d_%H%M%S)"
            mkdir -p "$COMPLETE_DIR"
            TITLE="$(t 'تنزيل شامل' 'Complete Package')"
            TEXT="$(t '📦 جاري التنزيل الشامل...' '📦 Downloading complete package...')"
            CMD="\"$YTDLP\" -f 'bestvideo+bestaudio/best' --write-thumbnail --write-sub --write-auto-sub --all-subs --write-description --write-info-json -o \"$COMPLETE_DIR/%(title)s.%(ext)s\" \"$URL\""
            SAVE_PATH="$COMPLETE_DIR"
            ;;
    esac

    run_with_progress "$TITLE" "$TEXT" "$CMD"
    local STATUS=$?
    show_result "$STATUS"
    [[ "$STATUS" == "0" ]] && open_folder "$SAVE_PATH"
}

