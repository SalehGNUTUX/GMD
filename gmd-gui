# ----------------------------
# تثبيت اختصار سطح المكتب
# ----------------------------
install_desktop_shortcut() {
    local DESKTOP_DIR="$HOME/.local/share/applications"
    local ICON_DIR="$HOME/.local/share/icons/hicolor/48x48/apps"
    mkdir -p "$DESKTOP_DIR" "$ICON_DIR"

    # تحميل الأيقونة
    if curl -fsSL "https://raw.githubusercontent.com/SalehGNUTUX/GMD/main/GMD%20APPIAMGE%20BIULD/gmd-icon.png" \
            -o "$ICON_DIR/gmd-icon.png" 2>/dev/null && [[ -s "$ICON_DIR/gmd-icon.png" ]]; then
        ICON_PATH="$ICON_DIR/gmd-icon.png"
    else
        ICON_PATH="utilities-terminal"
    fi

    cat > "$DESKTOP_DIR/gmd-gui.desktop" <<EOF
[Desktop Entry]
Version=1.0
Name=GMD-GUI - GNU Media Downloader
GenericName=Media Downloader
Comment=Download and convert media from the internet
Exec=$SELF_PATH
Icon=$ICON_PATH
Terminal=false
Type=Application
Categories=Utility;Network;AudioVideo;
Keywords=download;video;audio;youtube;converter;
StartupNotify=false
EOF
    chmod +x "$DESKTOP_DIR/gmd-gui.desktop"
    command -v update-desktop-database &>/dev/null && \
        update-desktop-database "$DESKTOP_DIR" 2>/dev/null
    echo "$(date)" > "$DESKTOP_MARKER"
}

# ----------------------------
# تحديث GMD-GUI
# ----------------------------
update_gmd_gui() {
    local BACKUP="${SELF_PATH}.bak"
    cp "$SELF_PATH" "$BACKUP" 2>/dev/null || true

    local TMP
    TMP=$(mktemp /tmp/gmd_gui_update.XXXXXX)

    run_with_progress \
        "$(t 'تحديث GMD-GUI' 'Update GMD-GUI')" \
        "$(t '⬆️ جاري تحميل أحدث نسخة...' '⬆️ Downloading latest version...')" \
        "curl -fsSL \"$REPO_RAW_URL\" -o \"$TMP\""

    if [[ -s "$TMP" ]]; then
        chmod +x "$TMP"
        mv "$TMP" "$SELF_PATH"
        rm -f "$BACKUP"
        echo "$(date +%s)" > "$UPDATE_MARKER"
        zrun --info \
             --text="✅ $(t 'تم تحديث GMD-GUI بنجاح!\nسيُعاد تشغيل البرنامج الآن.' 'GMD-GUI updated successfully!\nThe program will now restart.')" \
             --ok-label="$(t 'إعادة تشغيل' 'Restart')" \
             --width=400 2>/dev/null
        exec "$SELF_PATH"
    else
        rm -f "$TMP"
        [[ -f "$BACKUP" ]] && mv "$BACKUP" "$SELF_PATH"
        msg_error "$(t 'فشل التحديث.\nتم استعادة النسخة السابقة.' 'Update failed.\nPrevious version restored.')"
    fi
}

# ----------------------------
# إلغاء التثبيت الكامل
# ----------------------------
uninstall_gmd_gui() {
    msg_confirm "$(t '⚠️ هل أنت متأكد من إلغاء تثبيت GMD-GUI بالكامل؟\n\nسيتم حذف:\n• الملف التنفيذي\n• yt-dlp\n• أيقونة سطح المكتب\n• جميع الملفات الإضافية' \
'⚠️ Are you sure you want to completely uninstall GMD-GUI?\n\nThis will remove:\n• Executable file\n• yt-dlp\n• Desktop icon\n• All additional files')" || return 0

    rm -f "$YTDLP" 2>/dev/null
    rm -f "$HOME/.local/share/applications/gmd-gui.desktop" 2>/dev/null
    rm -f "$HOME/.local/share/icons/hicolor/48x48/apps/gmd-icon.png" 2>/dev/null
    rm -f "$DESKTOP_MARKER" "$UPDATE_MARKER" 2>/dev/null

    command -v update-desktop-database &>/dev/null && \
        update-desktop-database "$HOME/.local/share/applications" 2>/dev/null

    zrun --info \
         --text="✅ $(t 'تم إلغاء تثبيت GMD-GUI بالكامل بنجاح!\n\nيمكنك إعادة التثبيت في أي وقت.' \
'GMD-GUI completely uninstalled!\n\nYou can reinstall anytime.')" \
         --ok-label="$(t 'وداعاً!' 'Goodbye!')" \
         --width=380 2>/dev/null

    local SELF="$SELF_PATH"
    (sleep 2 && rm -f "$SELF") &
    exit 0
}

# ----------------------------
# تثبيت yt-dlp إن لم يكن موجوداً
# ----------------------------
install_yt_dlp() {
    if [[ -x "$YTDLP" ]]; then return 0; fi

    msg_confirm "$(t 'yt-dlp غير مثبت وهو ضروري للتنزيل.\nهل تريد تثبيته الآن؟' \
'yt-dlp is not installed and is required for downloading.\nWould you like to install it now?')" || exit 1

    run_with_progress \
        "$(t 'تثبيت yt-dlp' 'Install yt-dlp')" \
        "$(t '⬇️ جاري تثبيت yt-dlp...' '⬇️ Installing yt-dlp...')" \
        "curl -fsSL 'https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp' -o \"$YTDLP\" && chmod a+rx \"$YTDLP\""

    if [[ ! -x "$YTDLP" ]]; then
        msg_error "$(t 'فشل تثبيت yt-dlp.\nتحقق من اتصالك بالإنترنت.' 'Failed to install yt-dlp.\nCheck your internet connection.')"
        exit 1
    fi
    msg_ok "$(t 'تم تثبيت yt-dlp بنجاح!' 'yt-dlp installed successfully!')"
}

# ----------------------------
# التحقق من ffmpeg
# ----------------------------
check_ffmpeg() {
    if ! command -v ffmpeg &>/dev/null; then
        zrun --warning \
             --text="$(t '⚠️ ffmpeg غير مثبت.\nميزات التحويل وقص الوسائط لن تعمل.\n\nللتثبيت:\nsudo apt install ffmpeg' \
'⚠️ ffmpeg is not installed.\nConvert and trim features will not work.\n\nTo install:\nsudo apt install ffmpeg')" \
             --ok-label="$(t 'فهمت' 'Understood')" \
             --width=380 2>/dev/null
    fi
}

# ----------------------------
# وضع التثبيت
# ----------------------------
if [[ "${1:-}" == "--install" ]]; then
    echo "⬇️  جاري تثبيت GMD-GUI..."
    mkdir -p "$BIN_DIR"

    local_tmp=$(mktemp /tmp/gmd_gui_install.XXXXXX)
    if curl -fsSL "$REPO_RAW_URL" -o "$local_tmp" 2>/dev/null && [[ -s "$local_tmp" ]]; then
        mv "$local_tmp" "$SELF_PATH"
    elif [[ -f "$0" && -s "$0" ]]; then
        cp "$0" "$SELF_PATH"
        rm -f "$local_tmp"
    else
        rm -f "$local_tmp"
        echo "❌ فشل التثبيت."
        exit 1
    fi
    chmod +x "$SELF_PATH"

    # إصلاح PATH
    for RC in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile"; do
        if [[ -f "$RC" ]] && ! grep -q 'local/bin' "$RC" 2>/dev/null; then
            echo '' >> "$RC"
            echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$RC"
            break
        fi
    done
    export PATH="$BIN_DIR:$PATH"

    echo "✅ تم التثبيت في $SELF_PATH"
    echo "🚀 جاري التشغيل..."
    sleep 1
    exec "$SELF_PATH"
fi

