# ----------------------------
# ميزة جديدة: قص الفيديو/الصوت
# ----------------------------
clip_media() {
  while true; do
    if [[ "$L" == "ar" ]]; then
      echo ""
      echo "┌─────────────────────────────────────┐"
      echo "│    $ICON_CLIP قص الفيديو/الصوت         │"
      echo "├─────────────────────────────────────┤"
      echo "│  1) قص مقطع من رابط مباشرة         │"
      echo "│  2) قص ملف موجود على الجهاز        │"
      echo "├─────────────────────────────────────┤"
      echo "│  $ICON_BACK 0) ❌ إلغاء والعودة للقائمة │"
      echo "└─────────────────────────────────────┘"
      read -p "اختر خيارًا: " clip_opt
    else
      echo ""
      echo "┌─────────────────────────────────────┐"
      echo "│    $ICON_CLIP Trim Video/Audio         │"
      echo "├─────────────────────────────────────┤"
      echo "│  1) Trim from URL directly          │"
      echo "│  2) Trim an existing local file     │"
      echo "├─────────────────────────────────────┤"
      echo "│  $ICON_BACK 0) ❌ Cancel & Back to Menu  │"
      echo "└─────────────────────────────────────┘"
      read -p "Choose an option: " clip_opt
    fi

    case $clip_opt in
      0) return 0;;
      1)
        local URL
        URL=$(get_url) || continue
        if [[ "$L" == "ar" ]]; then
          read -p "وقت البداية (مثال: 00:01:30 أو 90): " START_TIME
          read -p "وقت النهاية (مثال: 00:03:00 أو 180): " END_TIME
        else
          read -p "Start time (e.g. 00:01:30 or 90): " START_TIME
          read -p "End time (e.g. 00:03:00 or 180): " END_TIME
        fi
        choose_save_path || continue
        echo "$ICON_DOWNLOAD جاري التنزيل والقص..."
        "$YTDLP" --download-sections "*${START_TIME}-${END_TIME}" \
          --force-keyframes-at-cuts \
          -o "$SAVE_PATH/%(title)s_clip.%(ext)s" "$URL"
        echo "$ICON_SUCCESS تم القص بنجاح!"
        [[ -n "$FILE_MANAGER" ]] && $FILE_MANAGER "$SAVE_PATH" 2>/dev/null
        ;;
      2)
        local FILE
        FILE=$(choose_file_path) || continue
        if [[ "$L" == "ar" ]]; then
          read -p "وقت البداية (مثال: 00:01:30): " START_TIME
          read -p "وقت النهاية (مثال: 00:03:00): " END_TIME
        else
          read -p "Start time (e.g. 00:01:30): " START_TIME
          read -p "End time (e.g. 00:03:00): " END_TIME
        fi
        choose_save_path || continue
        local BNAME EXT_F OUT
        BNAME=$(basename "$FILE")
        EXT_F="${BNAME##*.}"
        OUT="$SAVE_PATH/${BNAME%.*}_clip.$EXT_F"
        echo "$ICON_CLIP جاري القص..."
        ffmpeg -ss "$START_TIME" -to "$END_TIME" -i "$FILE" -c copy "$OUT" 2>/dev/null
        if [[ -f "$OUT" ]]; then
          echo "$ICON_SUCCESS تم القص بنجاح: $OUT"
          echo "📊 الحجم: $(du -h "$OUT" 2>/dev/null | cut -f1)"
        else
          echo "$ICON_ERROR فشل القص."
        fi
        [[ -n "$FILE_MANAGER" ]] && $FILE_MANAGER "$SAVE_PATH" 2>/dev/null
        ;;
      *) echo "$ICON_ERROR خيار غير صالح.";;
    esac

    if [[ "$L" == "ar" ]]; then
      read -p "اضغط Enter للمتابعة..." dummy
    else
      read -p "Press Enter to continue..." dummy
    fi
  done
}

