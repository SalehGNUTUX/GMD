# ----------------------------
# إعداد اللغة (قابل للتغيير)
# ----------------------------
LANGUAGE="ar"
L="ar"
set_lang() {
  if [[ "$LANGUAGE" == "ar" ]]; then
    L="ar"
  else
    L="en"
  fi
}

set_lang

# ----------------------------
# خيار التبديل بين اللغتين
# ----------------------------
toggle_lang() {
  if [[ "$LANGUAGE" == "ar" ]]; then
    LANGUAGE="en"
    L="en"
  else
    LANGUAGE="ar"
    L="ar"
  fi
  show_logo
  echo ""
  if [[ "$L" == "ar" ]]; then
    echo "✅ تم تغيير اللغة إلى العربية."
  else
    echo "✅ Language switched to English."
  fi
}

# ----------------------------
# إصلاح PATH ليشمل ~/.local/bin
# ----------------------------
ensure_path() {
    local BIN="$HOME/.local/bin"
    if [[ ":$PATH:" != *":$BIN:"* ]]; then
        export PATH="$BIN:$PATH"
    fi
    # إضافة السطر إلى ملف الـ shell إذا لم يكن موجوداً
    local SHELL_RC=""
    if [[ -f "$HOME/.bashrc" ]]; then
        SHELL_RC="$HOME/.bashrc"
    elif [[ -f "$HOME/.zshrc" ]]; then
        SHELL_RC="$HOME/.zshrc"
    elif [[ -f "$HOME/.profile" ]]; then
        SHELL_RC="$HOME/.profile"
    fi
    if [[ -n "$SHELL_RC" ]]; then
        if ! grep -q 'local/bin' "$SHELL_RC" 2>/dev/null; then
            echo '' >> "$SHELL_RC"
            echo '# GMD: إضافة ~/.local/bin إلى PATH' >> "$SHELL_RC"
            echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$SHELL_RC"
        fi
    fi
}

# ----------------------------
# وضع التثبيت المباشر
# ----------------------------
if [[ "${1:-}" == "--install" || "${1:-}" == "--install-desktop" ]]; then
    MODE="${1:-}"
    echo "⬇️  جاري تثبيت GMD..."
    mkdir -p ~/.local/bin

    # تحميل مباشر من المستودع دائماً لضمان أحدث نسخة
    local_tmp=$(mktemp /tmp/gmd_install.XXXXXX)
    if curl -fsSL "https://raw.githubusercontent.com/SalehGNUTUX/GMD/main/gmd" \
            -o "$local_tmp" 2>/dev/null && [[ -s "$local_tmp" ]]; then
        mv "$local_tmp" ~/.local/bin/gmd
    elif [[ -f "$0" && -s "$0" ]]; then
        cp "$0" ~/.local/bin/gmd
        rm -f "$local_tmp"
    else
        rm -f "$local_tmp"
        echo "❌ فشل التثبيت: لا يمكن تحميل الملف."
        exit 1
    fi
    chmod +x ~/.local/bin/gmd

    # إصلاح PATH
    local_bin="$HOME/.local/bin"
    if [[ ":$PATH:" != *":$local_bin:"* ]]; then
        export PATH="$local_bin:$PATH"
    fi
    for RC in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile"; do
        if [[ -f "$RC" ]] && ! grep -q 'local/bin' "$RC" 2>/dev/null; then
            echo '' >> "$RC"
            echo '# GMD: إضافة ~/.local/bin إلى PATH' >> "$RC"
            echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$RC"
            break
        fi
    done

    echo "✅ تم تثبيت GMD بنجاح في ~/.local/bin/gmd"

    # تثبيت اختصار سطح المكتب إن طُلب
    if [[ "$MODE" == "--install-desktop" ]]; then
        ~/.local/bin/gmd --fix-desktop
    fi

    echo ""
    echo "🚀 جاري تشغيل GMD..."
    echo ""
    sleep 1
    exec ~/.local/bin/gmd
fi

# ----------------------------
# وضع التحديث
# ----------------------------
if [[ "${1:-}" == "--update" ]]; then
    echo "⬇️  جاري تحديث GMD..."
    local_tmp=$(mktemp /tmp/gmd_update.XXXXXX)
    if curl -fsSL "https://raw.githubusercontent.com/SalehGNUTUX/GMD/main/gmd" \
            -o "$local_tmp" 2>/dev/null && [[ -s "$local_tmp" ]]; then
        mv "$local_tmp" ~/.local/bin/gmd
        chmod +x ~/.local/bin/gmd
    elif [[ -f "$0" && -s "$0" ]]; then
        cp "$0" ~/.local/bin/gmd.tmp
        chmod +x ~/.local/bin/gmd.tmp
        mv ~/.local/bin/gmd.tmp ~/.local/bin/gmd
        rm -f "$local_tmp"
    else
        rm -f "$local_tmp"
        echo "❌ فشل التحديث."
        exit 1
    fi
    echo "✅ تم تحديث GMD بنجاح!"
    echo ""
    echo "🚀 جاري تشغيل GMD..."
    sleep 1
    exec ~/.local/bin/gmd
fi

# ----------------------------
# وضع إصلاح اختصار سطح المكتب
# ----------------------------
if [[ "${1:-}" == "--fix-desktop" ]]; then
    echo "🔧 جاري إصلاح اختصار سطح المكتب..."
    DESKTOP_DIR="$HOME/.local/share/applications"
    ICON_DIR="$HOME/.local/share/icons/hicolor/48x48/apps"
    mkdir -p "$DESKTOP_DIR" "$ICON_DIR"
    if curl -fsSL "https://raw.githubusercontent.com/SalehGNUTUX/GMD/main/GMD%20APPIAMGE%20BIULD/gmd-icon.png" \
            -o "$ICON_DIR/gmd-icon.png" 2>/dev/null && [[ -s "$ICON_DIR/gmd-icon.png" ]]; then
        ICON_PATH="$ICON_DIR/gmd-icon.png"
    else
        ICON_PATH="utilities-terminal"
    fi
    cat > "$DESKTOP_DIR/gmd.desktop" <<EOF
[Desktop Entry]
Version=1.0
Name=GMD - GNU Media Downloader
GenericName=Media Downloader
Comment=Download and convert media from the internet
Exec=$HOME/.local/bin/gmd
Icon=$ICON_PATH
Terminal=true
Type=Application
Categories=Utility;Network;AudioVideo;
Keywords=download;video;audio;youtube;converter;
StartupNotify=false
EOF
    chmod +x "$DESKTOP_DIR/gmd.desktop"
    command -v update-desktop-database &>/dev/null && \
        update-desktop-database "$DESKTOP_DIR" 2>/dev/null
    mkdir -p "$HOME/.config"
    echo "$(date)" > "$HOME/.config/gmd_desktop_installed"
    echo "✅ تم إصلاح اختصار سطح المكتب بنجاح!"
    exit 0
fi

# ----------------------------
# وضع إلغاء التثبيت (من سطر الأوامر)
# ----------------------------
if [[ "${1:-}" == "--clean-uninstall" ]]; then
    echo "🗑️  جاري إلغاء تثبيت GMD تماماً..."
    read -p "هل أنت متأكد من إلغاء تثبيت GMD بالكامل؟ [y/N]: " confirm
    if [[ ! "${confirm:-}" =~ ^[Yy]$ ]]; then
        echo "ℹ️  تم إلغاء العملية."
        exit 0
    fi
    rm -f "$HOME/.local/bin/yt-dlp" 2>/dev/null
    rm -f "$HOME/.local/share/applications/gmd.desktop" 2>/dev/null
    rm -f "$HOME/.config/gmd_desktop_installed" "$HOME/.config/gmd_last_update" 2>/dev/null
    rm -rf "$HOME/.config/gmd" "$HOME/.GMD" 2>/dev/null
    for size in "16x16" "24x24" "32x32" "48x48" "64x64" "128x128" "256x256" "512x512"; do
        rm -f "$HOME/.local/share/icons/hicolor/$size/apps/gmd-icon.png" 2>/dev/null
    done
    command -v update-desktop-database &>/dev/null && \
        update-desktop-database "$HOME/.local/share/applications" 2>/dev/null
    echo "✅ تم إلغاء تثبيت GMD بالكامل بنجاح!"
    (sleep 1 && rm -f "$HOME/.local/bin/gmd") &
    sleep 2
    exit 0
fi

