# ----------------------------
# وظيفة: تنزيل وتحويل مباشر
# ----------------------------
download_and_convert() {
  local URL
  URL=$(get_url) || return 1
  choose_conversion_format || return 1
  choose_save_path || return 1

  echo "$ICON_SMART جاري التحليل والتنزيل الذكي..."
  local INFO_FILE
  INFO_FILE=$(mktemp)
  "$YTDLP" --dump-json "$URL" > "$INFO_FILE" 2>/dev/null || true

  if [[ -s "$INFO_FILE" ]]; then
    local ORIG_EXT TITLE
    ORIG_EXT=$(python3 -c "import json; d=json.load(open('$INFO_FILE')); print(d.get('ext',''))" 2>/dev/null || echo "")
    TITLE=$(python3 -c "import json; d=json.load(open('$INFO_FILE')); print(d.get('title','video'))" 2>/dev/null || echo "video")
    TITLE=$(echo "$TITLE" | tr -d '\n' | sed 's/[<>:"/\\|?*]//g')

    if [[ "$ORIG_EXT" == "$EXT" ]]; then
      echo "$ICON_INFO الملف الأصلي بصيغة $ORIG_EXT، لا حاجة للتحويل."
      echo "$ICON_DOWNLOAD جاري التنزيل مباشرة..."
      if [[ "$EXT" == "mp4" || "$EXT" == "webm" ]]; then
        choose_video_quality || { rm -f "$INFO_FILE"; return 1; }
        "$YTDLP" -f "$FORMAT" -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
      else
        local AO
        case $EXT in
          mp3) AO="--extract-audio --audio-format mp3 --audio-quality 0";;
          m4a) AO="--extract-audio --audio-format m4a";;
          ogg) AO="--extract-audio --audio-format vorbis";;
          wav) AO="--extract-audio --audio-format wav";;
          flac) AO="--extract-audio --audio-format flac";;
          *) AO="--extract-audio --audio-format mp3";;
        esac
        "$YTDLP" $AO -o "$SAVE_PATH/${TITLE}.%(ext)s" "$URL"
      fi
    else
      echo "$ICON_INFO الملف الأصلي بصيغة $ORIG_EXT، سيتم تحويله إلى $EXT"
      local TEMP_DIR
      TEMP_DIR=$(mktemp -d)
      echo "$ICON_DOWNLOAD جاري التنزيل المؤقت..."
      "$YTDLP" -f "best" -o "$TEMP_DIR/%(title)s.%(ext)s" "$URL"
      local DOWNLOADED_FILE
      DOWNLOADED_FILE=$(find "$TEMP_DIR" -type f -name "*.$ORIG_EXT" 2>/dev/null | head -1)
      [[ -z "$DOWNLOADED_FILE" ]] && \
        DOWNLOADED_FILE=$(find "$TEMP_DIR" -type f 2>/dev/null | head -1)

      if [[ -f "$DOWNLOADED_FILE" ]]; then
        echo "$ICON_CONVERT جاري التحويل إلى $EXT..."
        local BNAME OUTPUT_FILE
        BNAME=$(basename "$DOWNLOADED_FILE" ".$ORIG_EXT")
        OUTPUT_FILE="$SAVE_PATH/${BNAME}.${EXT}"
        ffmpeg -i "$DOWNLOADED_FILE" $CONV_OPTS "$OUTPUT_FILE" 2>/dev/null
        if [[ $? -eq 0 ]] && [[ -f "$OUTPUT_FILE" ]]; then
          echo "$ICON_SUCCESS تم التحويل بنجاح إلى: $OUTPUT_FILE"
        else
          echo "$ICON_ERROR فشل التحويل، حفظ الملف الأصلي."
          cp "$DOWNLOADED_FILE" "$SAVE_PATH/"
        fi
        rm -rf "$TEMP_DIR"
      else
        echo "$ICON_ERROR لم يتم العثور على الملف الذي تم تنزيله."
        rm -rf "$TEMP_DIR"
        rm -f "$INFO_FILE"
        return 1
      fi
    fi
    rm -f "$INFO_FILE"
  else
    echo "$ICON_ERROR لا يمكن الحصول على معلومات الملف. جاري التنزيل المباشر..."
    if [[ "$EXT" == "mp4" || "$EXT" == "webm" ]]; then
      choose_video_quality || { rm -f "$INFO_FILE"; return 1; }
      "$YTDLP" -f "$FORMAT" -o "$SAVE_PATH/%(title)s.%(ext)s" "$URL"
    else
      local AO2
      case $EXT in
        mp3) AO2="--extract-audio --audio-format mp3 --audio-quality 0";;
        m4a) AO2="--extract-audio --audio-format m4a";;
        ogg) AO2="--extract-audio --audio-format vorbis";;
        wav) AO2="--extract-audio --audio-format wav";;
        flac) AO2="--extract-audio --audio-format flac";;
        *) AO2="--extract-audio --audio-format mp3";;
      esac
      "$YTDLP" $AO2 -o "$SAVE_PATH/%(title)s.%(ext)s" "$URL"
    fi
    rm -f "$INFO_FILE"
  fi

  local OUTPUT_FILE
  OUTPUT_FILE=$(find "$SAVE_PATH" -type f -newer /proc/self 2>/dev/null | head -1)
  [[ -f "$OUTPUT_FILE" ]] && \
    echo "$ICON_SUCCESS تم إنشاء الملف: $OUTPUT_FILE" && \
    echo "📊 الحجم: $(du -h "$OUTPUT_FILE" 2>/dev/null | cut -f1)"
  [[ -n "$FILE_MANAGER" ]] && $FILE_MANAGER "$SAVE_PATH" 2>/dev/null
  return 0
}

